<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Тесты отрисовки рисуют на настоящем холсте SkiaSharp, поэтому нативная библиотека нужна
         и здесь: без явной ссылки на Linux приезжает 2.88 и тесты падают (D-058). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoEngine.App\GoEngine.App.csproj" />
  </ItemGroup>

  <!-- Тема — часть контракта размеров: её числа обязаны совпадать с PlatformMetrics.For.
       Файл включён ресурсом сборки тестов, чтобы проверка читала ту же разметку, что уезжает
       в приложение, а не копию в тестовом коде. -->
  <ItemGroup>
    <Content Include="..\GoEngine.App\Views\UiTheme.axaml" Link="Views\UiTheme.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>