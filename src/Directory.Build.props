<Project>

  <!--
    Общие свойства всех проектов Go Engine.
    Проекты задают только то, что у них особенное: OutputType, IsTestProject, пакеты и ссылки.
    Правила игры и стиля — GO_RULES.md, AGENTS.md, AGENTS_GO.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>ru</NeutralLanguage>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Product>Go Engine</Product>
    <Authors>Go Engine</Authors>

    <!-- На сборочном агенте пути в сборке детерминированы (воспроизводимые артефакты). -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Метка сборки выпуска: её ставит только CI (-p:OfficialBuild=true). По ней приложение понимает,
    можно ли сравнивать свою версию с выпусками, и не выдаёт заводское «1.0.0» за номер выпуска:
    хвост коммита SDK добавляет и локальной сборке, поэтому по строке версии их не отличить.
  -->
  <ItemGroup Condition="'$(OfficialBuild)' == 'true'">
    <AssemblyMetadata Include="OfficialBuild" Value="true" />
  </ItemGroup>

</Project>
