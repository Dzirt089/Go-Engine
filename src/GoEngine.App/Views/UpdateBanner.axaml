<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.Views.UpdateBanner"
             IsVisible="False">

  <!-- Приглашение обновления: карточка ПО ЦЕНТРУ экрана на затемнении. Раньше она стояла полосой
       под верхней строкой оболочки, и на телефоне сообщение о новой версии оказывалось строкой
       поверх доски (жалоба пользователя 2026-10-02 «вышло обновление … должно быть в центре
       экрана»). Затемнение — кисть темы (AppOverlayBrush), а не жёсткий цвет: палитра одна
       на светлую и тёмную тему, и цвет затемнения обязан приходить из неё.

       Затемнение и карточка — РАЗНЫЕ слои: затемнение нажатия не ловит
       (IsHitTestVisible="False"), поэтому доска остаётся доступной, как и было решено
       в D-066 §4, а карточка ловит нажатия своими кнопками. Если повесить этот признак
       на общий слой, кнопки «Позже» и «Отмена» перестали бы работать: IsHitTestVisible
       наследуется детьми.

       Содержимое ставит код вида (UpdateBanner.axaml.cs): строки и проценты считает модель
       представления, поэтому оболочка и экран настроек показывают одно состояние. -->
  <Panel>
    <Border x:Name="Scrim"
            Classes="app-overlay"
            IsHitTestVisible="False" />

    <Border x:Name="BannerCard"
            Classes="app-banner app-overlay-card"
            Padding="12,10"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Spacing="6">

        <TextBlock x:Name="HeadlineText"
                   Classes="app-banner-title"
                   TextWrapping="Wrap" />

        <!-- Подробность: «Скачивание… 42%», «Установка…» или слово установщика. -->
        <TextBlock x:Name="StatusText"
                   Classes="app-banner-detail"
                   TextWrapping="Wrap"
                   IsVisible="False" />

        <!-- Полоса хода: во время скачивания показывает честные проценты по байтам, во время
             установки идёт сама — измеримых шагов у неё нет. Оформление берётся у темы
             (FluentTheme), своих кистей и файлов проект не заводит. -->
        <ProgressBar x:Name="ProgressBar"
                     Minimum="0"
                     Maximum="100"
                     Height="8"
                     IsVisible="False" />

        <!-- Действия: скачать сейчас, отменить скачивание или убрать приглашение. Показываются
             по состоянию модели: во время загрузки «Обновить сейчас» уже не нужно. -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Classes="app-banner-action" Content="Отмена" IsVisible="False" />
          <Button x:Name="LaterButton" Classes="app-banner-action" Content="Позже" IsVisible="False" />
          <Button x:Name="UpdateNowButton"
                  Classes="app-banner-action primary"
                  Content="Обновить сейчас"
                  IsVisible="False" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Panel>

</UserControl>
