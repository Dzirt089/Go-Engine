<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.Views.UpdateBanner"
             IsVisible="False">

  <!-- Приглашение обновления: компактная карточка полосой под верхней строкой оболочки. Это не
       диалог поверх партии — доска остаётся доступной, а «Позже» убирает карточку до следующего
       запуска. Содержимое ставит код вида (UpdateBanner.axaml.cs): строки и проценты считает
       модель представления, поэтому оболочка и экран настроек показывают одно состояние. -->
  <Border x:Name="BannerCard"
          Classes="app-banner"
          Margin="10,8,10,0"
          Padding="12,10"
          MaxWidth="560"
          HorizontalAlignment="Center">
    <StackPanel Spacing="6">

      <TextBlock x:Name="HeadlineText"
                 Classes="app-banner-title"
                 TextWrapping="Wrap" />

      <!-- Подробность: «Скачивание… 42%», «Установка…» или слово установщика. -->
      <TextBlock x:Name="StatusText"
                 Classes="app-banner-detail"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <!-- Полоса хода: во время скачивания показывает честные проценты по байтам, во время
           установки идёт сама — измеримых шагов у неё нет. Оформление берётся у темы
           (FluentTheme), своих кистей и файлов проект не заводит. -->
      <ProgressBar x:Name="ProgressBar"
                   Minimum="0"
                   Maximum="100"
                   Height="8"
                   IsVisible="False" />

      <!-- Действия: скачать сейчас, отменить скачивание или убрать приглашение. Показываются
           по состоянию модели: во время загрузки «Обновить сейчас» уже не нужно. -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="app-banner-action" Content="Отмена" IsVisible="False" />
        <Button x:Name="LaterButton" Classes="app-banner-action" Content="Позже" IsVisible="False" />
        <Button x:Name="UpdateNowButton"
                Classes="app-banner-action primary"
                Content="Обновить сейчас"
                IsVisible="False" />
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
