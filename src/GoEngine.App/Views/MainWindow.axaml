<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoEngine.App.Views"
        xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
        x:Class="GoEngine.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Go Engine"
        Icon="/Assets/goengine.ico"
        Width="920"
        Height="720"
        MinWidth="360"
        MinHeight="320">

  <DockPanel>

    <!-- Меню партии действует на партию, поэтому в режиме задач его пункты недоступны: код окна
         следит за режимом оболочки и выключает их. «Справка» остаётся доступной всегда — сведения
         о программе к партии не относятся (замечание пользователя 2026-10-06). -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem x:Name="GameMenuItem" Header="Партия">
        <MenuItem x:Name="NewGameItem" Header="Новая партия" />
        <MenuItem x:Name="SettingsItem" Header="Настройка партии…" />
        <Separator />
        <MenuItem x:Name="SaveGameItem" Header="Сохранить партию…" />
        <MenuItem x:Name="LoadGameItem" Header="Загрузить партию…" />
        <Separator />
        <MenuItem x:Name="ExitItem" Header="Выход" />
      </MenuItem>

      <MenuItem Header="Справка">
        <MenuItem x:Name="AboutItem" Header="О программе…" />
      </MenuItem>
    </Menu>

    <!-- Оболочка режимов: партия и задачи. Вид партии живёт внутри неё и не пересоздаётся
         при переключении, поэтому партия не сбрасывается. -->
    <views:ShellView x:Name="ModeShell" />

  </DockPanel>

</Window>
