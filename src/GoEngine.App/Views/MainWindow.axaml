<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoEngine.App.Views"
        xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
        x:Class="GoEngine.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Go Engine"
        Icon="/Assets/goengine.ico"
        Width="920"
        Height="720"
        MinWidth="360"
        MinHeight="420">

  <DockPanel>

    <!-- Меню действует на партию, поэтому в режиме задач оно недоступно: код окна следит
         за режимом оболочки и выключает меню. -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="Партия">
        <MenuItem x:Name="NewGameItem" Header="Новая партия" />
        <MenuItem x:Name="SettingsItem" Header="Настройки…" />
        <Separator />
        <MenuItem x:Name="SaveGameItem" Header="Сохранить партию…" />
        <MenuItem x:Name="LoadGameItem" Header="Загрузить партию…" />
        <Separator />
        <MenuItem x:Name="ExitItem" Header="Выход" />
      </MenuItem>
    </Menu>

    <!-- Оболочка режимов: партия и задачи. Вид партии живёт внутри неё и не пересоздаётся
         при переключении, поэтому партия не сбрасывается. -->
    <views:ShellView x:Name="ModeShell" />

  </DockPanel>

</Window>
