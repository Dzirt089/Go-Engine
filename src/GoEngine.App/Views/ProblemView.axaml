<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.ProblemView"
             x:DataType="vm:ProblemViewModel">

  <!-- Задачи: та же доска, что и в партии (BoardControl), но своя панель и своя модель.
       Раскладку выбирает код вида (ProblemView.axaml.cs) по BoardLayoutRules: на узком экране
       доска сверху и панель снизу, на широком — доска слева, панель справа.

       Панель собрана в три полосы, как в уроках и разборе партий (замечание пользователя
       2026-10-10): сверху выбор задачи и переходы по списку, посередине условие и цель, снизу
       одна строка управления. Раньше выбор задачи стоял в прокрутке и «уезжал» при чтении,
       а кнопки занимали два ряда — на телефоне управление съедало полезное место. -->
  <Grid x:Name="Layout" ColumnDefinitions="*,320">

    <controls:BoardControl x:Name="Board"
                           Grid.Column="0"
                           Board="{Binding Board}"
                           LastMove="{Binding LastMove}"
                           HintPoint="{Binding HintPoint}" />

    <Border x:Name="Panel"
            Grid.Column="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1,0,0,0"
            Padding="12,10">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Шапка панели: стрелки перехода и выбор задачи. Список не прячется в свёртку
             и не прокручивается вместе с текстом: игрок видит, из чего выбирать. -->
        <Grid x:Name="PanelHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">

          <Button x:Name="PreviousButton"
                  Classes="app-icon"
                  AutomationProperties.Name="Предыдущая задача"
                  ToolTip.Tip="Предыдущая задача"
                  IsEnabled="{Binding CanGoPrevious}">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M14.6,5.2 L7.8,12 L14.6,18.8 L16.7,16.7 L12,12 L16.7,7.3 Z" />
          </Button>

          <ComboBox x:Name="ProblemBox"
                    Grid.Column="1"
                    MinHeight="44"
                    Margin="6,0,6,0"
                    HorizontalAlignment="Stretch" />

          <Button x:Name="NextButton"
                  Grid.Column="2"
                  Classes="app-icon"
                  AutomationProperties.Name="Следующая задача"
                  ToolTip.Tip="Следующая задача"
                  IsEnabled="{Binding CanGoNext}">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M9.4,5.2 L16.2,12 L9.4,18.8 L7.3,16.7 L12,12 L7.3,7.3 Z" />
          </Button>
        </Grid>

        <!-- Условие задачи и цель: то, что можно прочитать не спеша. -->
        <ScrollViewer x:Name="Conditions" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,0,0,8">

            <TextBlock x:Name="Heading" Text="Задачи" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" />

            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <!-- Цель — формулировка задачи так, как она записана в источнике. Отдельной строки
                 «Условие» в панели нет: она говорила о том же самом (замечание 2026-10-04). -->
            <TextBlock x:Name="Goal"
                       Text="{Binding GoalText, StringFormat='Цель: {0}'}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding ToMoveText, StringFormat='Ход: {0}'}" />
              <TextBlock Text="{Binding SizeText}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Вердикт и управление: эта часть не прокручивается и не уезжает за край экрана.
             Значки растянуты по ширине панели: три равные цели вместо ряда кнопок вразнобой. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,6,0,0">

          <!-- Вердикт хода: «Верно», «Это не решает задачу», «Задача решена», «Подсказка: …». -->
          <TextBlock x:Name="Verdict"
                     Grid.Row="0"
                     Text="{Binding Verdict}"
                     IsVisible="{Binding HasVerdict}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,0,0,6" />

          <Grid x:Name="PanelActions" Grid.Row="1" ColumnDefinitions="*,6,*,6,*">

            <Button x:Name="HintButton"
                    Classes="app-icon"
                    Width="NaN"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Подсказка"
                    ToolTip.Tip="Показать ход"
                    IsEnabled="{Binding CanHint}">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="M12,3.4 A5.6,5.6 0 0 1 15.2,13.6 L8.8,13.6 A5.6,5.6 0 0 1 12,3.4 Z M9.4,15.4 h5.2 v1.8 h-5.2 z M10.2,18.2 h3.6 v1.8 h-3.6 z" />
            </Button>

            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Classes="app-icon"
                    Width="NaN"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Отменить ход"
                    ToolTip.Tip="Отменить мой ход"
                    IsEnabled="{Binding CanBack}">
              <!-- Перечёркнутый круг: отмена хода. От «Заново» отличается намеренно. -->
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M6.2,8.4 L8.4,6.2 L17.8,15.6 L15.6,17.8 Z" />
            </Button>

            <Button x:Name="ResetButton"
                    Grid.Column="4"
                    Classes="app-icon"
                    Width="NaN"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Заново"
                    ToolTip.Tip="Начать задачу заново">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M12,0.8 L16.4,4.8 L12,8.8 Z" />
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
