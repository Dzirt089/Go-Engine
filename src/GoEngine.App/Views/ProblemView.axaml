<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.ProblemView"
             x:DataType="vm:ProblemViewModel">

  <!-- Режим задач: та же доска, что и в партии (BoardControl), но своя панель и своя модель.
       Раскладку выбирает код вида (ProblemView.axaml.cs) по BoardLayoutRules: на узком экране
       доска сверху и панель снизу, на широком — доска слева, панель справа.

       Панель разделена на две части: сверху описание задачи (на телефоне оно сворачивается,
       чтобы не обрываться на середине строки над кнопками), снизу — всегда видимые вердикт
       и кнопки. Раньше кнопки уезжали за край экрана: игрок видел задачу, но не мог ни
       подсказать ход, ни отменить его. -->
  <Grid x:Name="Layout" ColumnDefinitions="*,320">

    <controls:BoardControl x:Name="Board"
                           Grid.Column="0"
                           Board="{Binding Board}"
                           LastMove="{Binding LastMove}"
                           HintPoint="{Binding HintPoint}" />

    <Border x:Name="Panel"
            Grid.Column="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1,0,0,0"
            Padding="12,10">
      <Grid RowDefinitions="*,Auto">

        <!-- Описание задачи: то, что можно прочитать не спеша. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,0,0,8">

            <TextBlock x:Name="Heading" Text="Задачи" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" />

            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GoalText, StringFormat='Цель: {0}'}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding ToMoveText, StringFormat='Ход: {0}'}" />
              <TextBlock Text="{Binding SizeText}" />
            </StackPanel>

            <!-- Условие задачи и выбор задачи. На телефоне свёрнуто: развёрнутое описание выше
                 области прокрутки, и его низ обрывался на середине строки прямо над кнопками.
                 Ширина переключателя и содержимого — одна и та же: у темы Fluent Expander
                 выравнивается по содержимому (HorizontalAlignment=Left), и полоса заголовка
                 выходила не той ширины, что условие. Stretch на самом Expander и на его
                 содержимом выравнивает обе части по ширине панели и не даёт тексту обрезаться
                 на узком экране. -->
            <Expander x:Name="Details"
                      Header="Условие"
                      IsExpanded="True"
                      Margin="0,4,0,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                <!-- Условие задачи словами: у задач с сайта оно взято с источника. -->
                <TextBlock x:Name="TaskNote"
                           Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Задача" Margin="0,8,0,0" />
                <!-- Список заполняет код вида, а не привязка: список выбора сбрасывает индекс при подмене
                     ItemsSource и вернул бы его в модель — та же причина, что и в панели партии. -->
                <ComboBox x:Name="ProblemBox"
                          MinHeight="44"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>

        <!-- Вердикт и кнопки: эта часть не прокручивается и не уезжает за край экрана. -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,6,0,0">

          <!-- Вердикт хода: «Верно», «Это не решает задачу», «Задача решена», «Подсказка: …». -->
          <TextBlock x:Name="Verdict"
                     Text="{Binding Verdict}"
                     IsVisible="{Binding HasVerdict}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <!-- Кнопки не меньше 44 точек по высоте: это размер, по которому попадает палец. -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="HintButton" Content="Подсказка" MinHeight="44" MinWidth="104" IsEnabled="{Binding CanHint}" />
            <Button x:Name="BackButton" Content="Отменить" MinHeight="44" IsEnabled="{Binding CanBack}" />
            <Button x:Name="ResetButton" Content="Заново" MinHeight="44" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="PreviousButton" Content="Предыдущая" MinHeight="44" IsEnabled="{Binding CanGoPrevious}" />
            <Button x:Name="NextButton" Content="Следующая" MinHeight="44" IsEnabled="{Binding CanGoNext}" />
          </StackPanel>

        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
