<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Единый визуальный язык приложения: палитра, типографика, радиусы, отступы и размеры
       элементов. Палитра одна на настольную и мобильную версии: различается раскладка,
       а не цвета — иначе мобильный вид выглядел бы чужим для приложения.
       Цвета объявлены парами «кисть + цвет»: кисти берут виды через DynamicResource, поэтому
       смена значения здесь меняет вид сразу везде. -->

  <!-- Поверхности -->
  <Color x:Key="AppBackgroundColor">#F2F4F7</Color>
  <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
  <Color x:Key="AppSurfaceAltColor">#F7F9FC</Color>
  <Color x:Key="AppBorderColor">#DCE1E8</Color>
  <Color x:Key="AppBoardBackdropColor">#E9EDF3</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
  <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAltColor}" />
  <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
  <SolidColorBrush x:Key="AppBoardBackdropBrush" Color="{StaticResource AppBoardBackdropColor}" />

  <!-- Текст -->
  <Color x:Key="AppTextColor">#16202A</Color>
  <Color x:Key="AppTextMutedColor">#5B6B7C</Color>
  <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />

  <!-- Акцент: главное действие и выбранный раздел -->
  <Color x:Key="AppAccentColor">#1B6FE0</Color>
  <Color x:Key="AppAccentSoftColor">#E4EFFC</Color>
  <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
  <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}" />
  <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />

  <!-- Состояния: завершённая партия и предупреждение -->
  <SolidColorBrush x:Key="AppDangerBrush" Color="#B3261E" />
  <SolidColorBrush x:Key="AppOverlayBrush" Color="#66000000" />

  <!-- Типографика: четыре ступени, больше не нужно -->
  <x:Double x:Key="AppFontTitle">22</x:Double>
  <x:Double x:Key="AppFontSubtitle">16</x:Double>
  <x:Double x:Key="AppFontBody">14</x:Double>
  <x:Double x:Key="AppFontCaption">12</x:Double>
  <x:Double x:Key="AppFontNav">11</x:Double>

  <!-- Радиусы -->
  <CornerRadius x:Key="AppRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="AppRadiusMedium">14</CornerRadius>
  <CornerRadius x:Key="AppRadiusLarge">20</CornerRadius>

  <!-- Отступы -->
  <Thickness x:Key="AppPaddingPage">12</Thickness>
  <Thickness x:Key="AppPaddingCard">12,10</Thickness>
  <Thickness x:Key="AppPaddingCompact">8,4</Thickness>
  <x:Double x:Key="AppGapSmall">6</x:Double>
  <x:Double x:Key="AppGapMedium">10</x:Double>

  <!-- Размеры элементов: 48 точек — наименьшая цель, по которой попадает палец -->
  <x:Double x:Key="AppTouchTarget">48</x:Double>
  <x:Double x:Key="AppNavHeight">64</x:Double>
  <x:Double x:Key="AppStatusHeight">44</x:Double>
  <x:Double x:Key="AppSheetHandleHeight">28</x:Double>

  <!-- Итог партии: подложка, рамка и цвет текста для победы, поражения и ничьей.
       Цвета мягкие: это подложка карточки, а не акцент — кислотный фон спорил бы с доской
       и мешал читать счёт. Пары подобраны так, чтобы текст был контрастен своей подложке
       (не ниже 5:1 по WCAG): итог должен читаться на светлом фоне без напряжения. -->
  <Color x:Key="AppWinSoftColor">#E6F4EA</Color>
  <Color x:Key="AppWinBorderColor">#9CCFAF</Color>
  <Color x:Key="AppWinTextColor">#1B6B3A</Color>
  <SolidColorBrush x:Key="AppWinSoftBrush" Color="{StaticResource AppWinSoftColor}" />
  <SolidColorBrush x:Key="AppWinBorderBrush" Color="{StaticResource AppWinBorderColor}" />
  <SolidColorBrush x:Key="AppWinTextBrush" Color="{StaticResource AppWinTextColor}" />

  <Color x:Key="AppLoseSoftColor">#FBEAE8</Color>
  <Color x:Key="AppLoseBorderColor">#E3A79F</Color>
  <Color x:Key="AppLoseTextColor">#8C2C24</Color>
  <SolidColorBrush x:Key="AppLoseSoftBrush" Color="{StaticResource AppLoseSoftColor}" />
  <SolidColorBrush x:Key="AppLoseBorderBrush" Color="{StaticResource AppLoseBorderColor}" />
  <SolidColorBrush x:Key="AppLoseTextBrush" Color="{StaticResource AppLoseTextColor}" />

  <Color x:Key="AppDrawSoftColor">#EDF0F4</Color>
  <Color x:Key="AppDrawBorderColor">#C3CBD6</Color>
  <Color x:Key="AppDrawTextColor">#3F4C5A</Color>
  <SolidColorBrush x:Key="AppDrawSoftBrush" Color="{StaticResource AppDrawSoftColor}" />
  <SolidColorBrush x:Key="AppDrawBorderBrush" Color="{StaticResource AppDrawBorderColor}" />
  <SolidColorBrush x:Key="AppDrawTextBrush" Color="{StaticResource AppDrawTextColor}" />

  <!-- Разделители: тонкие линии между полосами интерфейса. Светлее рамки (AppBorderColor):
       линия только разделяет, а не очерчивает. -->
  <Color x:Key="AppDividerColor">#E3E7ED</Color>
  <SolidColorBrush x:Key="AppDividerBrush" Color="{StaticResource AppDividerColor}" />

  <!-- Метрики телефона: те же числа, что в ветке mobile функции PlatformMetrics.For
       (Services/PlatformMetrics.cs). XAML не умеет вызывать C#-функцию, поэтому значения
       продублированы ресурсами, а расхождение — ошибка, а не настройка. Ключи отдельные,
       а не общие AppTouchTarget и AppFontBody: настольные значения можно менять,
       не задев телефон. -->
  <x:Double x:Key="AppMobileTapTarget">48</x:Double>
  <x:Double x:Key="AppMobileFontBody">14</x:Double>
  <x:Double x:Key="AppMobileFontAction">13</x:Double>
  <CornerRadius x:Key="AppMobileRadiusSmall">8</CornerRadius>
  <Thickness x:Key="AppMobilePaddingAction">10,0</Thickness>
  <Thickness x:Key="AppMobilePaddingBar">8,0</Thickness>
  <Thickness x:Key="AppMobilePaddingPrimary">14,0</Thickness>

</ResourceDictionary>
