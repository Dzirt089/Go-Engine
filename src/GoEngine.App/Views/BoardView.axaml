<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.BoardView"
             x:DataType="vm:MainViewModel">

  <!-- Панель справа: состояние партии, соперник, выбор доски и уровня, действия.
       Цвета берутся из темы (DynamicResource), а не задаются жёстко: иначе на тёмной теме
       системы светлый текст попадал бы на светлый фон и панель было не прочитать.
       Разметка плотная, чтобы панель целиком помещалась в окно; на маленьком экране
       содержимое прокручивается. -->
  <Grid ColumnDefinitions="*,320">

    <controls:BoardControl x:Name="Board"
                           Grid.Column="0"
                           Board="{Binding Board}"
                           LastMove="{Binding LastMove}" />

    <Border Grid.Column="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1,0,0,0"
            Padding="12,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

          <TextBlock Text="Партия" FontSize="16" FontWeight="SemiBold" />

          <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
          <TextBlock Text="{Binding Score, StringFormat='Счёт: {0}'}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding ToMove, StringFormat='Ход: {0}'}" />
            <TextBlock Text="{Binding MoveNumber, StringFormat='Номер хода: {0}'}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Komi, StringFormat='Коми: {0}'}" />
            <TextBlock Text="{Binding PlayerColor, StringFormat='Мой цвет: {0}'}" />
          </StackPanel>

          <TextBlock Text="{Binding Captures, StringFormat='Снято: {0}'}" TextWrapping="Wrap" />

          <TextBlock Text="Соперник" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock Text="{Binding LevelDescription}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LevelHint}"
                     TextWrapping="Wrap"
                     FontStyle="Italic"
                     IsVisible="{Binding HasLevelHint}"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button x:Name="PassButton" Content="Пас" Classes="accent" />
            <Button x:Name="UndoButton" Content="Отменить" />
            <Button x:Name="RedoButton" Content="Вернуть" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <TextBlock Text="Доска" VerticalAlignment="Center" />
            <ComboBox x:Name="SizeBox"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SizeLabels}"
                      SelectedIndex="{Binding SelectedSizeIndex, Mode=TwoWay}" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="Уровень" VerticalAlignment="Center" />
            <ComboBox x:Name="LevelBox"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding LevelLabels}"
                      SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay}" />
          </Grid>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
            <Button x:Name="NewGameButton"
                    Content="Новая партия"
                    Margin="0,0,3,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    IsVisible="False"
                    Content="Настройки…"
                    Margin="3,0,0,0"
                    ToolTip.Tip="Размер доски, уровень AI, цвет игрока и коми"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="SaveButton"
                    Grid.Row="1"
                    IsVisible="False"
                    Content="Сохранить…"
                    Margin="0,6,3,0"
                    ToolTip.Tip="Сохранить партию в файл SGF"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="LoadButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    IsVisible="False"
                    Content="Загрузить…"
                    Margin="3,6,0,0"
                    ToolTip.Tip="Загрузить партию из файла SGF"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </Grid>

        </StackPanel>
      </ScrollViewer>
    </Border>

  </Grid>

</UserControl>