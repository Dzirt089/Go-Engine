<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:views="clr-namespace:GoEngine.App.Views"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.BoardView"
             x:DataType="vm:MainViewModel">

  <!-- Один и тот же вид работает в настольном окне и на телефоне.
       Раскладку выбирает код вида (BoardView.axaml.cs) по правилам BoardLayoutRules:
       шире 760 точек — настольный вид: доска слева, панель управления справа;
       уже — мобильный: доска на весь экран, действия над ней, шторка сведений снизу.
       Цвета берутся из темы (DynamicResource), а не задаются жёстко: иначе на тёмной теме
       системы светлый текст попадал бы на светлый фон и панель было не прочитать.

       Тексты в разметке не дублируются: строки состояния, счёта и итога собирает модель
       представления и чистые функции GameStatusLines, а вид только подставляет их. Правило
       записано после жалобы 2026-09-30: одна и та же мысль стояла в трёх местах сразу. -->

  <UserControl.Resources>
    <!-- Файловые действия телефона: сохранить и загрузить. Отдельная кнопка «Файл» с меню
         вместо двух кнопок — так строка действий остаётся читаемой в 360 точках, а редкие
         действия не спорят за место с ходом партии. -->
    <MenuFlyout x:Key="FileActionsFlyout">
      <MenuItem x:Name="MobileSaveMenuItem" Header="Сохранить партию" />
      <MenuItem x:Name="MobileLoadMenuItem" Header="Загрузить партию" />
    </MenuFlyout>
  </UserControl.Resources>

  <Panel x:Name="Root">

    <!-- Настольная раскладка. Панель справа прокручивается и содержит то, что не поместилось:
         состояние, счёт, выбор доски и уровня, сохранение и загрузка, настройки. -->
    <Grid x:Name="Layout" ColumnDefinitions="*,320">

      <!-- Доска одна на обе раскладки: при переключении она переносится в другое место
           (BoardView.axaml.cs), а не создаётся заново. -->
      <Border x:Name="DesktopBoardHost" Grid.Column="0">
        <controls:BoardControl x:Name="Board"
                               Board="{Binding Board}"
                               LastMove="{Binding LastMove}"
                               Territory="{Binding Territory}" />
      </Border>

      <Border x:Name="Panel"
              Grid.Column="1"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderThickness="1,0,0,0"
              Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">

            <!-- Итог партии стоит первым в панели и не уезжает при прокрутке: после конца партии
                 игрок должен видеть исход сразу, а не искать его (жалоба 2026-09-30). -->
            <views:GameResultBanner x:Name="DesktopResultBanner" />

            <!-- Состояние партии: кто ходит и что происходит. Итог называет баннер, поэтому
                 здесь его нет — иначе одно и то же сообщение стояло бы дважды. -->
            <TextBlock x:Name="DesktopStatusText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DesktopScoreText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Счёт по обеим системам: две короткие строки вместо прежнего разбора
                 с четырьмя повторами «территория + пленные + камни». -->
            <TextBlock x:Name="DesktopScoreDetailText"
                       Classes="app-label"
                       TextWrapping="Wrap" />

            <!-- Согласование мёртвых групп после двух пасов: пока идёт подсчёт, щелчок по доске
                 помечает группу, а не играет ход. Стоит выше прочего: во время согласования
                 это главное действие. Видна только в этом режиме. -->
            <Border x:Name="DesktopCountingPanel"
                    IsVisible="{Binding IsCounting}"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="{DynamicResource AppAccentSoftBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="Проверьте мёртвые группы: щелчок по группе помечает её мёртвой. Окончательный счёт — по кнопке."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}" />
                <Button x:Name="DesktopConfirmButton"
                        Content="Посчитать"
                        Classes="app-primary"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanConfirmScore}" />
              </StackPanel>
            </Border>

            <!-- Действия в один ряд: пас, отмена, возврат, территория и новая партия.
                 Ряд одинаков на обеих раскладках и отличается только размерами (жалоба 2026-09-30:
                 «перенеси кнопку территория наверх, рядом с другими кнопками»). -->
            <!-- Ряд действий: равные доли ширины панели, а не ширина по содержимому.
                 В прошлый раз кнопки стояли в StackPanel, и подпись «Начать партию»
                 не помещалась — кнопка уезжала за край (проверено живым прогоном 2026-09-30). -->
            <Grid x:Name="DesktopActionRow"
                  Classes="app-action-row"
                  ColumnDefinitions="*,*,*,*"
                  Margin="0,2,0,0">
              <Button x:Name="PassButton"
                      Grid.Column="0"
                      Content="Пас"
                      Classes="app-row-action primary" />
              <Button x:Name="UndoButton"
                      Grid.Column="1"
                      Content="Отменить"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanUndo}" />
              <Button x:Name="RedoButton"
                      Grid.Column="2"
                      Content="Вернуть"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanRedo}" />
              <ToggleButton x:Name="TerritoryButton"
                            Grid.Column="3"
                            Content="Территория"
                            Classes="app-toggle"
                            ToolTip.Tip="Показать, кому принадлежат пустые точки"
                            IsVisible="{Binding CanToggleTerritory}"
                            IsChecked="{Binding ShowTerritory}" />
            </Grid>

            <!-- Сведения о партии одной строкой: соперник, номер хода и коми. -->
            <TextBlock x:Name="DesktopStatsText"
                       Classes="app-label"
                       TextWrapping="Wrap" />

            <!-- Списки доски и уровня: ими игрок выбирает, с чем играть, поэтому они видны
                 всегда. Списки заполняет код вида (BoardView.axaml.cs), а не привязка: список
                 выбора сбрасывает индекс при подмене ItemsSource и вернул бы его в модель
                 представления, из-за чего партия начиналась не с выбранным уровнем. -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Доска" VerticalAlignment="Center" />
              <ComboBox x:Name="SizeBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Уровень" VerticalAlignment="Center" />
              <ComboBox x:Name="LevelBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Сообщения о сохранении, загрузке и отказах: на телефоне системных диалогов нет.
                 Строка исчезает сама через несколько секунд (BoardView.axaml.cs). -->
            <TextBlock x:Name="Hint"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- Подробности свёрнуты по умолчанию: постоянные строки про пленных и площадь
                 занимали пол-панели и повторяли то, что и так видно на доске. Разворачивает
                 их игрок, а не приложение за него. -->
            <ToggleButton x:Name="DesktopDetailsButton"
                          Content="Подробности"
                          Classes="app-toggle"
                          Margin="0,2,0,0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />

            <StackPanel x:Name="DesktopDetailsPanel" Spacing="6" IsVisible="False">
              <TextBlock x:Name="DesktopPrisonersText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="DesktopBreakdownText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <!-- Подсказка о том, почему уровней с сетью нет: строка нужна, но показывается
                   только когда есть что сказать. -->
              <TextBlock x:Name="DesktopLevelHintText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Главное действие партии — отдельной крупной кнопкой во всю ширину панели.
                 В ряду действий подпись «Начать партию» не помещалась: пять кнопок на 320 точек
                 панели обрезали её (проверено живым прогоном 2026-09-30). -->
            <Button x:Name="NewGameButton"
                    Content="Начать партию"
                    Classes="app-primary"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Stretch" />

            <Grid ColumnDefinitions="*,*,*">
              <Button x:Name="SettingsButton"
                      Content="Настройки…"
                      MinHeight="40"
                      Margin="0,0,3,0"
                      ToolTip.Tip="Размер доски, уровень AI, цвет игрока и коми"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="SaveButton"
                      Grid.Column="1"
                      Content="Сохранить"
                      MinHeight="40"
                      Margin="3,0,3,0"
                      ToolTip.Tip="Сохранить партию в файл SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="LoadButton"
                      Grid.Column="2"
                      Content="Загрузить"
                      MinHeight="40"
                      Margin="3,0,0,0"
                      ToolTip.Tip="Загрузить партию из файла SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

    <!-- Мобильная раскладка: доска занимает экран, действия — над доской, состояние и
         подробности — в шторке снизу с ручкой. -->
    <Grid x:Name="MobileLayout"
          IsVisible="False"
          RowDefinitions="Auto,Auto,*,Auto"
          Background="{DynamicResource AppBoardBackdropBrush}">

      <!-- Итог партии на телефоне — отдельная строка над доской: в свёрнутой шторке его
           не видно, а поверх доски карточка закрывала бы позицию и верхние ряды. -->
      <Border x:Name="MobileResultHost"
              Grid.Row="0"
              IsVisible="False"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,0,1">
        <views:GameResultBanner x:Name="MobileResultBanner" />
      </Border>

      <!-- Строка состояния: кто ходит и номер хода. Подробности (счёт, пленные, коми) — в шторке:
           на узком экране одна строка несёт одно главное сообщение. -->
      <Border Grid.Row="1"
              x:Name="MobileStatus"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,4"
              MinHeight="{DynamicResource AppStatusHeight}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Камень того, кто ходит: чёрный залит, белый — с обводкой, иначе он пропадал бы
               на светлой строке состояния. -->
          <Panel VerticalAlignment="Center">
            <Ellipse x:Name="MobileTurnBlack"
                     Width="14"
                     Height="14"
                     Fill="{DynamicResource AppTextBrush}" />
            <Ellipse x:Name="MobileTurnWhite"
                     Width="14"
                     Height="14"
                     IsVisible="False"
                     Fill="{DynamicResource AppSurfaceBrush}"
                     Stroke="{DynamicResource AppTextMutedBrush}"
                     StrokeThickness="1" />
          </Panel>
          <TextBlock x:Name="MobileTurnText"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="MobileMoveText"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     Classes="app-label"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <!-- Доска, приглашение подтвердить подсчёт и панель действий над ней. -->
      <Panel Grid.Row="2">
        <Border x:Name="MobileBoardHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        <Border x:Name="MobileCountingBar"
                IsVisible="{Binding IsCounting}"
                Classes="app-card"
                Padding="10"
                Margin="8,8,8,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Проверьте мёртвые группы: клик по группе помечает её"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="170"
                       Classes="app-value" />
            <Button x:Name="MobileConfirmButton"
                    Content="Посчитать"
                    Classes="app-primary"
                    IsEnabled="{Binding CanConfirmScore}" />
          </StackPanel>
        </Border>

        <!-- Панель действий: два ряда. В первом — четыре действия партии, во втором —
             «Начать партию» во всю ширину: до первого хода это главное действие экрана.
             Пять кнопок в один ряд в 360 точек не помещались (жалоба 2026-09-30). -->
        <Border x:Name="MobileActionBar"
                Classes="app-card"
                Padding="6"
                Margin="8,0,8,8"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center">
          <!-- Две строки фиксированной высоты: кнопка территории прячется, когда разметка
               включается сама, и панель не должна от этого прыгать. Во второй строке —
               «Начать партию» и «Файл» с сохранением и загрузкой: три кнопки в ряд здесь
               не помещаются, а файловые действия нужны редко. -->
          <StackPanel Spacing="6">
            <Grid x:Name="MobileActionRow" ColumnDefinitions="*,*,*,*" Classes="app-touch-row touch">
              <Button x:Name="MobilePassButton"
                      Grid.Column="0"
                      Content="Пас"
                      Classes="app-touch primary" />
              <Button x:Name="MobileUndoButton"
                      Grid.Column="1"
                      Content="Отменить"
                      Classes="app-touch"
                      IsEnabled="{Binding CanUndo}" />
              <Button x:Name="MobileRedoButton"
                      Grid.Column="2"
                      Content="Вернуть"
                      Classes="app-touch"
                      IsEnabled="{Binding CanRedo}" />
              <ToggleButton x:Name="MobileTerritoryButton"
                            Grid.Column="3"
                            Content="Территория"
                            Classes="app-touch-toggle"
                            IsVisible="{Binding CanToggleTerritory}"
                            IsChecked="{Binding ShowTerritory}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <Button x:Name="MobileNewGameButton"
                      Grid.Column="0"
                      Content="Начать партию"
                      Classes="app-touch primary"
                      HorizontalAlignment="Stretch" />
              <!-- Расстояние между кнопками — отступом: RowSpacing и ColumnSpacing у Grid
                   в Avalonia 11.2 нет (проверено сборкой, AVLN2000). -->
              <Button x:Name="MobileFileButton"
                      Grid.Column="1"
                      Content="Файл"
                      Classes="app-touch"
                      Margin="6,0,0,0"
                      Flyout="{StaticResource FileActionsFlyout}" />
            </Grid>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Шторка сведений: свёрнута — короткое состояние, развёрнута — подробности.
           Ручка и строка состояния вместе дают цель нажатия выше 48 точек. -->
      <Border x:Name="Sheet"
              Grid.Row="3"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="18,18,0,0">
        <StackPanel>

          <Button x:Name="SheetToggleButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="12,6"
                  MinHeight="{DynamicResource AppTouchTarget}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Подробности партии">
            <StackPanel Spacing="6">
              <Border Width="40"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource AppBorderBrush}" />
              <!-- Строки краткого состояния: на низком экране (телефон в ландшафте) они
                   убираются, чтобы доска не стала полоской. -->
              <StackPanel x:Name="SheetSummaryPanel" Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SheetSummary"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SheetChevron"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Classes="app-label"
                           VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="SheetSummaryDetails"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <!-- Сообщения о сохранении, загрузке и отказах видны и в свёрнутой шторке:
                   на телефоне системных диалогов нет. -->
              <TextBlock x:Name="MobileHint"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />
              </StackPanel>
            </StackPanel>
          </Button>

          <ScrollViewer x:Name="SheetDetails"
                        IsVisible="False"
                        MaxHeight="380"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,12" Spacing="8">

              <TextBlock Classes="app-subtitle" Text="Подробности" />

              <TextBlock x:Name="MobileStatusText" Classes="app-value" />

              <!-- Пленные, счёт по основной системе и разбор обеих систем: тот же порядок,
                   что и в настольной панели. -->
              <TextBlock x:Name="MobilePrisonersText" Classes="app-value" FontWeight="SemiBold" />
              <TextBlock x:Name="MobileScoreText" Classes="app-value" FontWeight="SemiBold" />
              <TextBlock x:Name="MobileScoreDetailText" Classes="app-label" TextWrapping="Wrap" />

              <Border x:Name="SheetCountingPanel"
                      IsVisible="{Binding IsCounting}"
                      Padding="10,8"
                      CornerRadius="8"
                      Background="{DynamicResource AppAccentSoftBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Проверьте мёртвые группы: щелчок по группе на доске помечает её мёртвой."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource AppTextBrush}" />
                  <Button x:Name="SheetConfirmButton"
                          Content="Посчитать"
                          Classes="app-primary"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding CanConfirmScore}" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="MobileBreakdownText"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasTerritory}" />

              <TextBlock x:Name="MobileStatsText" Classes="app-label" TextWrapping="Wrap" />

              <TextBlock Classes="app-label"
                         Text="{Binding LevelHint}"
                         IsVisible="{Binding HasLevelHint}"
                         FontStyle="Italic" />

              <WrapPanel>
                <Button x:Name="MobileSaveButton"
                        Content="Сохранить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <Button x:Name="MobileLoadButton"
                        Content="Загрузить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <!-- Единственный вход в настройки на телефоне: кнопка в панели действий
                     переехала сюда, чтобы не теснить «Начать партию» (жалоба 2026-09-30). -->
                <Button x:Name="MobileSettingsButton"
                        Content="Настройки"
                        Classes="app-action"
                        Margin="0,0,6,6" />
              </WrapPanel>

            </StackPanel>
          </ScrollViewer>

        </StackPanel>
      </Border>

    </Grid>

    <!-- Настройки поверх вида: окон на телефоне нет, поэтому тот же SettingsView показывается
         здесь. На узком экране это отдельный экран во всю высоту с заголовком и кнопкой «Назад»,
         на настольной версии — карточка по центру, а кнопка «Настройки» открывает окно
         (SettingsWindow). -->
    <Border x:Name="SettingsOverlay"
            IsVisible="False"
            Background="{DynamicResource AppOverlayBrush}">
      <Border x:Name="SettingsCard"
              MaxWidth="460"
              MaxHeight="640"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid RowDefinitions="Auto,*">
          <Border x:Name="SettingsHeader"
                  Grid.Row="0"
                  IsVisible="False"
                  Padding="10,8"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="SettingsBackButton"
                      Classes="app-action"
                      Content="Назад"
                      AutomationProperties.Name="Назад" />
              <TextBlock Grid.Column="1"
                         Classes="app-subtitle"
                         Text="Партия"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2" Width="66" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <views:SettingsView x:Name="SettingsArea" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

  </Panel>
</UserControl>
