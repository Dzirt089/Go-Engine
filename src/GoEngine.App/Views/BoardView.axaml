<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:views="clr-namespace:GoEngine.App.Views"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.BoardView"
             x:DataType="vm:MainViewModel">

  <!-- Один и тот же вид работает в настольном окне и на телефоне.
       Раскладку выбирает код вида (BoardView.axaml.cs) по правилам BoardLayoutRules:
       шире 760 точек — настольный вид: доска слева, панель управления справа;
       уже — мобильный: доска на весь экран, панель действий под ней по ширине доски,
       шторка сведений снизу.
       Цвета берутся из темы (DynamicResource), а не задаются жёстко: иначе на тёмной теме
       системы светлый текст попадал бы на светлый фон и панель было не прочитать.

       Тексты в разметке не дублируются: строки состояния, счёта и итога собирает модель
       представления и чистые функции GameStatusLines, а вид только подставляет их. Правило
       записано после жалобы 2026-09-30: одна и та же мысль стояла в трёх местах сразу. -->

  <Panel x:Name="Root">

    <!-- Настольная раскладка. Панель справа прокручивается и содержит то, что не поместилось:
         состояние, счёт, выбор доски и уровня, сохранение и загрузка, настройки. -->
    <Grid x:Name="Layout" ColumnDefinitions="*,320">

      <!-- Доска одна на обе раскладки: при переключении она переносится в другое место
           (BoardView.axaml.cs), а не создаётся заново. -->
      <Border x:Name="DesktopBoardHost" Grid.Column="0">
        <controls:BoardControl x:Name="Board"
                               Board="{Binding Board}"
                               LastMove="{Binding LastMove}"
                               Territory="{Binding Territory}" />
      </Border>

      <Border x:Name="Panel"
              Grid.Column="1"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderThickness="1,0,0,0"
              Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">

            <!-- Время партии и два действия с ним. Строка стоит выше прочих: время игрок
                 смотрит постоянно, а не ищет в подробностях. Кнопка часов одна на два
                 состояния — «Пауза» и «Дальше»: подпись меняет код вида. -->
            <Grid x:Name="DesktopClockRow" ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
              <TextBlock x:Name="DesktopClockText"
                         Classes="app-clock"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button x:Name="DesktopPauseButton"
                      Grid.Column="1"
                      Content="Пауза"
                      Classes="app-row-action"
                      Margin="4,0,4,0"
                      IsEnabled="{Binding CanTogglePause}"
                      ToolTip.Tip="Остановить время партии" />
              <Button x:Name="DesktopAbortButton"
                      Grid.Column="2"
                      Content="Отменить партию"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanAbortGame}"
                      ToolTip.Tip="Прекратить партию и вернуть доску в исходное состояние" />
            </Grid>

            <!-- Состояние партии: кто ходит, а после конца — «Партия окончена» и победитель.
                 Итог стоит в панели, а не только в закрываемом баннере: после его закрытия
                 результат обязан остаться на экране (дефект 2 QA 2026-10-17). Счёт — отдельной
                 строкой ниже, поэтому в этой строке его нет: он не должен звучать дважды. -->
            <TextBlock x:Name="DesktopStatusText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DesktopScoreText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Соперник и цвета в сетевой партии: имя названо один раз, здесь же его цвет. -->
            <TextBlock x:Name="NetworkOpponentText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!-- Ряд действий: пас, отмена, возврат и территория — равными долями ширины панели,
                 а не по содержимому (жалоба 2026-09-30: «перенеси кнопку территория наверх, рядом
                 с другими кнопками»; в StackPanel подпись «Начать партию» не помещалась и уезжала
                 за край — проверено живым прогоном 2026-09-30). «Начать партию» стоит отдельной
                 крупной кнопкой ниже: пять подписей в 320 точек не помещаются. -->
            <Grid x:Name="DesktopActionRow"
                  Classes="app-action-row"
                  ColumnDefinitions="*,*,*,*"
                  Margin="0,2,0,0">
              <Button x:Name="PassButton"
                      Grid.Column="0"
                      Content="Пас"
                      Classes="app-row-action primary"
                      ToolTip.Tip="Передать ход: вы отказываетесь ставить камень. Партия заканчивается, когда спасуют обе стороны."
                      IsEnabled="{Binding CanPass}" />
              <Button x:Name="UndoButton"
                      Grid.Column="1"
                      Content="Отменить"
                      Classes="app-row-action"
                      ToolTip.Tip="Отменить ваш последний ход вместе с ответом соперника"
                      IsEnabled="{Binding CanUndo}" />
              <Button x:Name="RedoButton"
                      Grid.Column="2"
                      Content="Вернуть"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanRedo}" />
              <!-- Переключатель остаётся в ряду И КОГДА НЕДОСТУПЕН: скрытая кнопка оставляла бы
                   четвёртую колонку пустой и ряд выглядел бы сломанным (жалоба 2026-10-02).
                   Доступность — отдельный признак модели. -->
              <ToggleButton x:Name="TerritoryButton"
                            Grid.Column="3"
                            Content="Территория"
                            Classes="app-toggle"
                            ToolTip.Tip="Предпросмотр: показать, кому принадлежат пустые точки. Правила и счёт не меняются."
                            IsEnabled="{Binding CanToggleTerritory}"
                            IsChecked="{Binding ShowTerritory}" />
            </Grid>

            <!-- Списки доски и уровня: ими игрок выбирает, с чем играть, поэтому они видны
                 всегда. Списки заполняет код вида (BoardView.axaml.cs), а не привязка: список
                 выбора сбрасывает индекс при подмене ItemsSource и вернул бы его в модель
                 представления, из-за чего партия начиналась не с выбранным уровнем. -->
            <Grid x:Name="SizePanel" ColumnDefinitions="Auto,*">
              <TextBlock Text="Доска" VerticalAlignment="Center" />
              <ComboBox x:Name="SizeBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <Grid x:Name="LevelPanel" ColumnDefinitions="Auto,*">
              <TextBlock Text="Уровень" VerticalAlignment="Center" />
              <ComboBox x:Name="LevelBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Кю и дан — сила соперника: 30 кю — самый слабый, чем меньше кю, тем сильнее; дан сильнее любого кю. «Нейросеть» — оценка позиции обученной сетью." />
            </Grid>

            <!-- Сообщения о сохранении, загрузке и отказах: на телефоне системных диалогов нет.
                 Строка исчезает сама через несколько секунд (BoardView.axaml.cs). -->
            <TextBlock x:Name="Hint"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- Подробности свёрнуты по умолчанию: соперник, ход, коми, разбор счёта и подсказка
                 об уровнях — то, что нужно не каждый ход. Содержимое обязано быть: кнопка,
                 раскрывающая пустую панель, выглядит сломанной (жалоба пользователя 2026-10-02). -->
            <ToggleButton x:Name="DesktopDetailsButton"
                          Content="Подробности"
                          Classes="app-toggle"
                          Margin="0,2,0,0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />

            <StackPanel x:Name="DesktopDetailsPanel" Spacing="6" IsVisible="False">
              <!-- Способ завершения партии: «Завершена сдачей». На главном экране он повторял
                   строку состояния, поэтому живёт в подробностях: кому нужно — развернёт. -->
              <TextBlock x:Name="DesktopStatusReasonText"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />

              <!-- Сведения о партии одной строкой: соперник, номер хода и коми. -->
              <TextBlock x:Name="DesktopStatsText"
                         Classes="app-label"
                         TextWrapping="Wrap" />

              <!-- Разбор обеих систем словами: он нужен тому, кто проверяет счёт, а не тому,
                   кто играет. Отдельное имя: строка короткого счёта стоит выше и заполняется
                   тем же текстом, но живёт всегда. -->
              <Border x:Name="DesktopResultCard"
                      Classes="app-banner result-card"
                      IsVisible="False"
                      Padding="10"
                      CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="DesktopResultHeadline" Classes="app-banner-title" TextWrapping="Wrap" />
                  <TextBlock x:Name="DesktopResultDetail" Classes="app-banner-detail" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="DesktopScoreJapaneseText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="DesktopScoreChineseText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="DesktopScoreDeadText"
                         Classes="app-label"
                         TextWrapping="Wrap" />

              <!-- Технические строки счёта — только здесь: на главном экране они превращались
                   в стену текста после каждой партии (жалоба пользователя 2026-11-09). -->
              <TextBlock x:Name="DesktopPrisonersText"
                         Classes="app-value"
                         TextWrapping="Wrap"
                         IsVisible="False" />
              <TextBlock x:Name="DesktopBreakdownText"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />

              <!-- Расшифровка двух слов, которые новичок встречает первыми: «пленные» и «коми».
                   Строка стоит рядом с числами, где эти слова действительно видны, и только
                   в подробностях — в конце каждой партии на главном экране она была лишней. -->
              <TextBlock x:Name="DesktopTermsHint"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         Text="Пленные — камни, снятые с доски. Коми — бонус белым за то, что чёрные ходят первыми." />

              <!-- Подсказка о том, почему уровней с сетью нет: строка нужна, но показывается
                   только когда есть что сказать. -->
              <TextBlock x:Name="DesktopLevelHintText"
                         Classes="app-label"
                         TextWrapping="Wrap" />

              <!-- После партии разметка территории уходит с главного экрана вместе с рядом
                   действий: кнопка без хода — мёртвая. Кому нужен предпросмотр владения,
                   найдёт его здесь. -->
              <ToggleButton x:Name="DesktopDetailsTerritoryButton"
                            Content="Показать территорию"
                            Classes="app-toggle"
                            IsVisible="False"
                            IsChecked="{Binding ShowTerritory}"
                            IsEnabled="{Binding CanToggleTerritory}" />
            </StackPanel>

            <!-- «Начать партию» до партии не нужна: игра начинается с первого хода по доске.
                 После итога кнопка становится «Новой партией» — единственным осмысленным
                 действием на панели, когда ряд хода убран (замечание пользователя 2026-11-09). -->
            <Button x:Name="NewGameButton"
                    IsEnabled="{Binding CanStartNewGame}"
                    Content="Начать партию"
                    Classes="app-primary"
                    Margin="0,2,0,0"
                    IsVisible="False"
                    HorizontalAlignment="Stretch" />
            <Grid x:Name="AiFilesRow" ColumnDefinitions="*,*,*">
              <Button x:Name="SettingsButton"
                    IsEnabled="{Binding CanChangeGameSettings}"
                      Content="Настройки…"
                      MinHeight="40"
                      Margin="0,0,3,0"
                      ToolTip.Tip="Размер доски, уровень AI, цвет игрока и коми"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="SaveButton"
                      Grid.Column="1"
                      Content="Сохранить"
                      MinHeight="40"
                      Margin="3,0,3,0"
                      ToolTip.Tip="Сохранить партию в файл SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="LoadButton"
                      Grid.Column="2"
                      Content="Загрузить"
                      MinHeight="40"
                      Margin="3,0,0,0"
                      ToolTip.Tip="Загрузить партию из файла SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

    <!-- Мобильная раскладка: доска занимает экран, действия — под ней, состояние и подробности —
         в шторке снизу с ручкой. Строки итога здесь больше нет: баннер итога один на обе раскладки
         и стоит оверлеем по центру экрана (жалоба пользователя 2026-10-02). -->
    <Grid x:Name="MobileLayout"
          IsVisible="False"
          RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource AppBoardBackdropBrush}">

      <!-- Шапка телефона: действия партии слева, кто ходит и время — в середине, «Пауза» справа.
           Вход в меню партии (☰) и в «Настройку партии» (шестерёнка) стоят в шапке, а не в ряду
           действий: ряд под доской занят ходом партии, а эти действия редкие и должны быть
           под рукой в одно касание (замечание пользователя 2026-10-06).

           Высота целей нажатия — 44 точки, отступы сжаты до 2: строка состояния обязана остаться
           короткой, иначе доска теряет место (AppStatusHeight). Подписи в строке обрезаются
           многоточием: подробности (счёт, пленные, коми) живут в шторке. -->
      <Border Grid.Row="0"
              x:Name="MobileStatus"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="6,2"
              MinHeight="{DynamicResource AppStatusHeight}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="MobileMenuButton"
                  Classes="app-icon"
                  AutomationProperties.Name="Меню партии"
                  ToolTip.Tip="Новая партия, файлы и настройка партии">
            <!-- Три точки, а не «три полосы»: полосы стоят у раздела «Меню» в нижней навигации,
                 и одинаковые значки путали игрока — он ждал от кнопки партии то же самое, что
                 от раздела приложения (замечание пользователя 2026-10-07). -->
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M12,4.6 A2.3,2.3 0 1 1 12,9.2 A2.3,2.3 0 1 1 12,4.6 Z M12,9.7 A2.3,2.3 0 1 1 12,14.3 A2.3,2.3 0 1 1 12,9.7 Z M12,14.8 A2.3,2.3 0 1 1 12,19.4 A2.3,2.3 0 1 1 12,14.8 Z" />
          </Button>

          <!-- Сетка, а не StackPanel: StackPanel даёт тексту бесконечную ширину, и подпись
               «Игра с ИИ · Ход: Чёрные» наезжала на часы. Звёздная колонка обрезает текст
               многоточием, часы остаются справа без наложения. -->
          <Grid Grid.Column="1"
                ColumnDefinitions="Auto,*"
                Margin="4,0,6,0"
                VerticalAlignment="Center">
            <!-- Камень того, кто ходит: чёрный залит, белый — с обводкой, иначе он пропадал бы
                 на светлой строке состояния. -->
            <Panel Grid.Column="0" VerticalAlignment="Center">
              <Ellipse x:Name="MobileTurnBlack"
                       Width="14"
                       Height="14"
                       Fill="{DynamicResource AppTextBrush}" />
              <Ellipse x:Name="MobileTurnWhite"
                       Width="14"
                       Height="14"
                       IsVisible="False"
                       Fill="{DynamicResource AppSurfaceBrush}"
                       Stroke="{DynamicResource AppTextMutedBrush}"
                       StrokeThickness="1" />
            </Panel>
            <TextBlock x:Name="MobileTurnText"
                       Grid.Column="1"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </Grid>

          <TextBlock x:Name="MobileClockText"
                     Grid.Column="2"
                     MinWidth="52"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"
                     Classes="app-clock"
                     TextTrimming="None" />
        </Grid>
      </Border>

      <!-- Доска и панель действий.
           Доска и панель занимают РАЗНЫЕ строки сетки: панель действий не плавает поверх доски,
           и нижние ряды не уходят под кнопки — на телефоне это было видно сразу (живой прогон
           2026-09-30, эмулятор API 35). Между ними гарантированный зазор: верхний отступ панели
           плюс поля доски внутри её строки. Полоса «Проверьте пометки… Посчитать» убрана:
           оценка приходит сама, и просить игрока подтверждать её кнопкой больше не нужно
           (жалоба пользователя 2026-10-02). -->
      <Grid Grid.Row="1" RowDefinitions="*,Auto">
        <Panel x:Name="MobileBoardRow" Grid.Row="0">
          <Border x:Name="MobileBoardHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

          <!-- Сообщения о сохранении, загрузке и отказах: всплывающая плашка над панелью
               действий, а не строка в нижней карточке. Строка в карточке меняла её высоту,
               и доска сдвигалась вверх на 29 px при каждом сообщении (дефект 4 QA 2026-10-17).
               Плашка — оверлей: в раскладке она не участвует, доска не двигается. Нажатий
               она не ловит, поэтому доска под ней остаётся играбельной. -->
          <Border x:Name="MobileHintPill"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Center"
                  Margin="8"
                  MaxWidth="420"
                  Padding="12,6"
                  CornerRadius="12"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Background="{DynamicResource AppSurfaceBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1">
            <TextBlock x:Name="MobileHint"
                       Classes="app-label"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </Border>
        </Panel>

      <!-- Панель действий: один ряд, и в нём — только ход партии: пас, отмена, возврат
           и разметка территории. Часы и «Пауза» стоят в шапке, «Новая партия», «Отменить партию»,
           файлы и настройки переехали в меню (кнопка «Меню» в нижней навигации): в 360 точках
           пять кнопок в ряд не помещались (жалоба пользователя 2026-10-02), а теперь ряд стал
           ровным и компактным.
           После конца партии ряд хода убирается целиком: пас в законченной партии ничего
           не делает, а разметка территории переезжает в «Подробности». Остаётся одно осмысленное
           действие — «Новая партия» или выход из сетевой игры (жалоба пользователя 2026-11-09:
           две серые кнопки после итога читались как поломка).
           Панель идёт во всю ширину доски, а не «плавающей» карточкой по центру: раньше её ширина
           зависела от подписей, она была уже доски и заезжала за нижний край (жалоба 2026-10-02
           «наезжает на доску и сделан не аккуратно»). Ширину ограничивает код вида
           (BoardLayoutRules.MobileActionBarWidth): по ширине доски, но не уже читаемой.
           Верхний отступ — гарантированный зазор между доской и панелью. -->
      <Border x:Name="MobileActionBar"
              Grid.Row="1"
              Classes="app-card"
              Padding="8"
              Margin="8,8,8,8"
              HorizontalAlignment="Stretch">
        <Grid>
          <Grid x:Name="MobileActionRow" ColumnDefinitions="*,*,*,1.25*" Classes="app-touch-row touch">
            <Button x:Name="MobilePassButton"
                    Grid.Column="0"
                    Content="Пас"
                    Classes="app-touch primary"
                    ToolTip.Tip="Передать ход: вы отказываетесь ставить камень. Партия заканчивается, когда спасуют обе стороны."
                    IsEnabled="{Binding CanPass}" />
            <Button x:Name="MobileUndoButton"
                    Grid.Column="1"
                    Content="Отменить"
                    Classes="app-touch"
                    ToolTip.Tip="Отменить ваш последний ход вместе с ответом соперника"
                    IsEnabled="{Binding CanUndo}" />
            <Button x:Name="MobileRedoButton"
                    Grid.Column="2"
                    Content="Вернуть"
                    Classes="app-touch"
                    IsEnabled="{Binding CanRedo}" />
            <!-- Переключатель остаётся в ряду и тогда, когда недоступен: скрытая кнопка
                 оставляла четвёртую колонку пустой, и ряд выглядел сломанным (жалоба
                 пользователя 2026-10-02). После конца партии ряду хода здесь не место —
                 его заменяет одно действие ниже. -->
            <ToggleButton x:Name="MobileTerritoryButton"
                          Grid.Column="3"
                          Content="Территория"
                          Classes="app-touch-toggle"
                          ToolTip.Tip="Предпросмотр: показать, кому принадлежат пустые точки. Правила и счёт не меняются."
                          IsEnabled="{Binding CanToggleTerritory}"
                          IsChecked="{Binding ShowTerritory}" />
          </Grid>

          <!-- Действие после итога: одно, крупное и понятное. В сети им нельзя начать
               новую партию, пока не вышел из сетевой, поэтому там кнопка выхода. -->
          <Grid x:Name="MobilePostGameRow" ColumnDefinitions="*" Classes="app-touch-row touch" IsVisible="False">
            <Button x:Name="MobilePostGameNewGameButton"
                    Content="Новая партия"
                    Classes="app-touch primary"
                    IsVisible="False" />
            <Button x:Name="MobilePostGameLeaveButton"
                    Content="Выйти из сетевой игры"
                    Classes="app-touch primary"
                    IsVisible="False" />
          </Grid>
        </Grid>
      </Border>
      </Grid>

      <!-- Шторка сведений: свёрнута — короткое состояние, развёрнута — подробности.
           Ручка и строка состояния вместе дают цель нажатия выше 48 точек. -->
      <Border x:Name="Sheet"
              Grid.Row="2"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="18,18,0,0">
        <StackPanel>

          <Button x:Name="SheetToggleButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="12,6"
                  MinHeight="{DynamicResource AppTouchTarget}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Подробности партии">
            <StackPanel Spacing="6">
              <Border Width="40"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource AppBorderBrush}" />
              <!-- Строки краткого состояния: на низком экране (телефон в ландшафте) они
                   убираются, чтобы доска не стала полоской.
                   Свёрнутая шторка — три коротких строки: итог одной фразой, счёт и соперник.
                   Технические строки и толкование терминов живут только в «Подробностях»:
                   после каждой партии они превращались в стену текста (жалоба 2026-11-09). -->
              <StackPanel x:Name="SheetSummaryPanel" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="SheetSummary"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="SheetChevron"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             Classes="app-label"
                             VerticalAlignment="Center" />
                </Grid>
                <!-- Счёт одной строкой: после итога он уходит из первой строки сюда. -->
                <TextBlock x:Name="SheetSummaryDetails"
                           Classes="app-label"
                           TextWrapping="Wrap"
                           IsVisible="False" />
                <!-- Соперник и цвета — один раз и коротко, без повторения в подробностях. -->
                <TextBlock x:Name="MobileOpponentSummary"
                           Classes="app-label"
                           TextWrapping="Wrap"
                           IsVisible="False" />
              </StackPanel>
            </StackPanel>
          </Button>

          <ScrollViewer x:Name="SheetDetails"
                        IsVisible="False"
                        MaxHeight="380"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,12" Spacing="8">

              <TextBlock Classes="app-subtitle" Text="Подробности" />

              <!-- Итог объявляется карточкой: цвет говорит «выиграл / проиграл / ничья»,
                   и она видна всегда, пока партия окончена. Игрок просил вернуть это объявление
                   (жалоба 2026-10-11): раньше итог был только в закрываемом баннере. -->
              <Border x:Name="MobileResultCard"
                      Classes="app-banner result-card"
                      IsVisible="False"
                      Padding="10"
                      CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="MobileResultHeadline" Classes="app-banner-title" TextWrapping="Wrap" />
                  <TextBlock x:Name="MobileResultDetail" Classes="app-banner-detail" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- Три системы подсчёта — тремя блоками, а не одним куском текста: «стену»
                   из японской и китайской величин читать нельзя (жалоба 2026-10-11). -->
              <TextBlock x:Name="MobileScoreJapaneseText" Classes="app-label" TextWrapping="Wrap" />
              <TextBlock x:Name="MobileScoreChineseText" Classes="app-label" TextWrapping="Wrap" />
              <TextBlock x:Name="MobileScoreDeadText" Classes="app-label" TextWrapping="Wrap" />

              <!-- Технические строки счёта — только здесь. На главном экране они превращались
                   в стену текста после каждой партии (жалоба пользователя 2026-11-09). -->
              <TextBlock x:Name="MobileBreakdownText"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />
              <TextBlock x:Name="MobilePrisonersText"
                         Classes="app-value"
                         TextWrapping="Wrap"
                         IsVisible="False" />

              <!-- Толкование слов «пленные» и «коми»: строка стоит рядом с числами, где эти
                   слова действительно видны, и только в подробностях. В свёрнутой шторке
                   она повторялась после каждой партии (находки QA L3 и L4; жалоба 2026-11-09). -->
              <TextBlock x:Name="MobileTermsHint"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         Text="Пленные — камни, снятые с доски. Коми — бонус белым за то, что чёрные ходят первыми." />

              <TextBlock x:Name="MobileStatsText" Classes="app-label" TextWrapping="Wrap" />

              <TextBlock x:Name="MobileLevelHintText"
                         Classes="app-label"
                         Text="{Binding LevelHint}"
                         FontStyle="Italic" />

              <!-- После итога разметка территории уходит с главного экрана: там остаётся одно
                   действие. Кому нужен предпросмотр владения — переключатель здесь. -->
              <ToggleButton x:Name="MobileDetailsTerritoryButton"
                            Content="Показать территорию"
                            Classes="app-toggle"
                            IsVisible="False"
                            IsChecked="{Binding ShowTerritory}"
                            IsEnabled="{Binding CanToggleTerritory}" />

              <WrapPanel x:Name="MobileFilesPanel">
                <Button x:Name="MobileSaveButton"
                        Content="Сохранить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <Button x:Name="MobileLoadButton"
                        Content="Загрузить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <!-- «Настройка партии» открывается шестерёнкой в шапке и строкой меню партии:
                     третий вход в подробностях был бы лишним (замечание 2026-10-06). -->
              </WrapPanel>

            </StackPanel>
          </ScrollViewer>

        </StackPanel>
      </Border>

    </Grid>

    <!-- Меню партии: шторка снизу. Сюда переехали действия, которые на телефоне не помещаются
         в ряд под доской: «Начать партию»/«Новая партия», «Отменить партию», файлы и «Настройка
         партии» (замечание пользователя 2026-10-03), а сама карточка по центру заменена шторкой —
         она ближе к большому пальцу и не закрывает доску целиком (замечание 2026-10-06).
         Открывает шторку кнопка ☰ в шапке партии; закрывается нажатием по затемнению, свайпом вниз
         по ручке и строкой «Закрыть». Сама шторка лежит в слое затемнения: нажатие мимо неё
         попадает в подложку и закрывает меню. -->
    <Border x:Name="MenuOverlay"
            IsVisible="False">
      <Panel>
        <!-- Затемнение: кнопка во весь слой. Кнопка, а не рамка, потому что нажатие должно
             закрывать меню и на телефоне, где указателя нет. -->
        <Button x:Name="MenuBackdrop"
                Classes="app-backdrop"
                AutomationProperties.Name="Закрыть меню партии" />

        <Border x:Name="MenuCard"
                Classes="app-sheet"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">
          <StackPanel>

            <!-- Ручка шторки: за неё шторка тянется вниз и закрывается. Полоса нажатия выше
                 самого штриха — по тонкой линии палец не попадёт. -->
            <Border x:Name="MenuSheetHandle"
                    Background="Transparent"
                    Padding="0,8,0,2"
                    MinHeight="28">
              <Border Width="40"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AppBorderBrush}" />
            </Border>

            <TextBlock Classes="app-subtitle"
                       Text="Меню партии"
                       HorizontalAlignment="Center"
                       Margin="12,2,12,8" />

            <!-- Закончить партию — выход из положения «доиграл, а соперник не пасует»:
                 правило двух пасов требует паса от обеих сторон, и без этой строки партия
                 не заканчивалась вовсе (блокер B1 отчёта QA 2026-10-17). Счёт подводится
                 по текущей позиции, поэтому строка стоит рядом с «Начать партию». -->
            <!-- Скрытая строка «Начать партию»: новый ход начинает игру сам. Оставлена
                 невидимой, чтобы «Новая партия» из меню оставалась доступной взрослым
                 и в проверочных сценариях. -->
            <Button x:Name="MenuNewGameButton"
                    Classes="app-menu-row primary"
                    AutomationProperties.Name="Начать партию"
                    IsEnabled="{Binding CanStartNewGame}"
                    IsVisible="False">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z" />
                <TextBlock x:Name="MenuNewGameText"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Начать партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuPauseButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Пауза"
                    IsVisible="False">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M8,4 h3 v16 h-3 z M13,4 h3 v16 h-3 z" />
                <TextBlock x:Name="MenuPauseText"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Пауза"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuFinishButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Закончить партию"
                    IsEnabled="{Binding CanFinishGame}">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Флажок: партия доведена до конца, и подводится итог. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M5,3 h2 v18 h-2 z M7,4 h11 l-2.6,3.5 L18,11 H7 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Закончить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuLeaveNetworkButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Выйти из сетевой игры"
                    IsVisible="{Binding IsNetworkGame}"
                    IsEnabled="{Binding CanLeaveNetwork}">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M4,4 h7 v2 h-5 v12 h5 v2 h-7 z M14.2,7.5 L19,12 L14.2,16.5 v-3 h-4.2 v-3 h4.2 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Выйти из сетевой игры"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuResignNetworkButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Сдаться"
                    IsVisible="{Binding IsNetworkGame}"
                    IsEnabled="{Binding IsNetworkMyTurn}">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M6,3 h2 v18 h-2 z M8,4 h10 v2 h-10 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Сдаться"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuAbortButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Отменить партию"
                    IsEnabled="{Binding CanAbortGame}">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Перечёркнутый круг: партия прекращается, доска возвращается в исходное
                     состояние. Крест остаётся только у строки «Закрыть» — два одинаковых
                     креста в одной шторке путали игрока (замечание пользователя 2026-10-07). -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M6.2,8.4 L8.4,6.2 L17.8,15.6 L15.6,17.8 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Отменить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuSaveButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Сохранить партию">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Дискета: сохранение партии в файл SGF. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M4,4 h13 l3,3 v13 h-16 z M8,4 h8 v6 h-8 z M7,14 h10 v6 h-10 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Сохранить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuLoadButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Загрузить партию">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Папка: загрузка партии из файла SGF. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M3,5 h6.5 l2,2 h9.5 v12 h-18 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Загрузить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuSettingsButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Настройка партии"
                    IsEnabled="{Binding CanChangeGameSettings}">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Та же шестерёнка, что и в шапке: «Настройка партии» — один и тот же экран. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,8.4 A3.6,3.6 0 1 0 12,15.6 A3.6,3.6 0 1 0 12,8.4 Z M10.6,1.6 h2.8 v4.4 h-2.8 z M10.6,18 h2.8 v4.4 h-2.8 z M1.6,10.6 h4.4 v2.8 h-4.4 z M18,10.6 h4.4 v2.8 h-4.4 z M17.2,3.4 L20.6,6.8 L17.2,10.2 L13.8,6.8 Z M6.8,3.4 L10.2,6.8 L6.8,10.2 L3.4,6.8 Z M6.8,13.8 L10.2,17.2 L6.8,20.6 L3.4,17.2 Z M17.2,13.8 L20.6,17.2 L17.2,20.6 L13.8,17.2 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Настройка партии"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Border Classes="app-divider" Margin="14,4" />

            <Button x:Name="MenuCloseButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Закрыть меню">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Закрыть"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Итог партии — один на обе раскладки, оверлеем поверх вида: затемнение и карточка
         по центру экрана. Раньше баннеров было два (по одному на раскладку), и оба стояли полосой
         сверху — на телефоне полоса оказывалась отдельной строкой сетки, уезжала от взгляда
         и теснила доску (жалоба пользователя 2026-10-02). Стоит до экрана настроек: настройки
         открываются поверх всего. -->
    <views:GameResultBanner x:Name="ResultBanner" />

    <!-- Подтверждение отмены партии: тот же вопрос, что у «Выхода», и по той же причине —
         одно неосторожное нажатие не должно уносить партию. Раньше «Отменить партию»
         обнуляла доску сразу, без диалога (дефект 1 QA 2026-10-17). Затемнение и карточка —
         те же классы темы, что у подтверждения выхода в оболочке; «Отмена» возвращает
         к партии, «Отменить партию» — единственный путь отсюда к отмене. -->
    <Border x:Name="AbortOverlay"
            IsVisible="False"
            Classes="app-overlay">
      <Border Classes="app-banner app-overlay-card"
              MaxWidth="420"
              Padding="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Classes="app-subtitle"
                     Text="Отменить партию?"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="app-label"
                     Text="Несохранённая партия будет потеряна."
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <Button x:Name="AbortCancelButton"
                    Grid.Column="0"
                    Content="Отмена"
                    Classes="app-action"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="AbortConfirmButton"
                    Grid.Column="1"
                    Content="Отменить партию"
                    Classes="app-action danger"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Подтверждение конца партии: счёт подводится, и законченную партию уже не продолжить.
         Вопрос нужен по той же причине, что и у отмены: одно неосторожное нажатие в меню
         не должно завершать недоигранную партию. «Отмена» возвращает к партии, «Закончить
         партию» — единственный путь к итогу по согласию (блокер B1 отчёта QA 2026-10-17).
         Если позиция явно недоиграна, счёт не принимается, и карточка итога предложит
         вернуться к партии (N2 отчёта QA 2026-10-17). -->
    <Border x:Name="FinishOverlay"
            IsVisible="False"
            Classes="app-overlay">
      <Border Classes="app-banner app-overlay-card"
              MaxWidth="420"
              Padding="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Classes="app-subtitle"
                     Text="Закончить партию?"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="app-label"
                     Text="Партия завершится сейчас: счёт посчитается по текущей позиции, и итог появится на экране. Если позиция недоиграна, счёт не будет принят, и партию можно будет доиграть."
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <Button x:Name="FinishCancelButton"
                    Grid.Column="0"
                    Content="Отмена"
                    Classes="app-action"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="FinishConfirmButton"
                    Grid.Column="1"
                    Content="Закончить партию"
                    Classes="app-action"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Настройки — полноценный экран во всю высоту вида, а не карточка: подразделов три,
         и в карточке 460×640 они не помещались (жалоба пользователя 2026-10-03). Сверху заголовок,
         внизу — «Сохранить» и «Отмена» из самого вида настроек. На настольной раскладке те же
         настройки показывает окно (SettingsWindow) — этот экран там не открывается. -->
    <Border x:Name="SettingsOverlay"
            IsVisible="False"
            Background="{DynamicResource AppBackgroundBrush}">
      <Border x:Name="SettingsCard"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource AppBackgroundBrush}">
        <Grid RowDefinitions="Auto,*">
          <Border x:Name="SettingsHeader"
                  Grid.Row="0"
                  Padding="10,8"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,0,1">
            <TextBlock x:Name="SettingsTitle"
                       Classes="app-subtitle"
                       Text="Настройка партии"
                       VerticalAlignment="Center" />
          </Border>

          <!-- Прокрутка и низ экрана — внутри самого вида настроек: общий вид сам делит место
               между подразделами и кнопками «Сохранить»/«Отмена». -->
          <views:SettingsView x:Name="SettingsArea" Grid.Row="1" />
        </Grid>
      </Border>
    </Border>

  </Panel>
</UserControl>
