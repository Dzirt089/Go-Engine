<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:views="clr-namespace:GoEngine.App.Views"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.BoardView"
             x:DataType="vm:MainViewModel">

  <!-- Один и тот же вид работает в настольном окне и на телефоне.
       Раскладку выбирает код вида (BoardView.axaml.cs) по правилам BoardLayoutRules:
       шире 760 точек — настольный вид: доска слева, панель управления справа;
       уже — мобильный: доска на весь экран, панель действий под ней по ширине доски,
       шторка сведений снизу.
       Цвета берутся из темы (DynamicResource), а не задаются жёстко: иначе на тёмной теме
       системы светлый текст попадал бы на светлый фон и панель было не прочитать.

       Тексты в разметке не дублируются: строки состояния, счёта и итога собирает модель
       представления и чистые функции GameStatusLines, а вид только подставляет их. Правило
       записано после жалобы 2026-09-30: одна и та же мысль стояла в трёх местах сразу. -->

  <Panel x:Name="Root">

    <!-- Настольная раскладка. Панель справа прокручивается и содержит то, что не поместилось:
         состояние, счёт, выбор доски и уровня, сохранение и загрузка, настройки. -->
    <Grid x:Name="Layout" ColumnDefinitions="*,320">

      <!-- Доска одна на обе раскладки: при переключении она переносится в другое место
           (BoardView.axaml.cs), а не создаётся заново. -->
      <Border x:Name="DesktopBoardHost" Grid.Column="0">
        <controls:BoardControl x:Name="Board"
                               Board="{Binding Board}"
                               LastMove="{Binding LastMove}"
                               Territory="{Binding Territory}" />
      </Border>

      <Border x:Name="Panel"
              Grid.Column="1"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderThickness="1,0,0,0"
              Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">

            <!-- Время партии и два действия с ним. Строка стоит выше прочих: время игрок
                 смотрит постоянно, а не ищет в подробностях. Кнопка часов одна на два
                 состояния — «Пауза» и «Продолжить»: подпись меняет код вида. -->
            <Grid x:Name="DesktopClockRow" ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
              <TextBlock x:Name="DesktopClockText"
                         Classes="app-clock"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button x:Name="DesktopPauseButton"
                      Grid.Column="1"
                      Content="Пауза"
                      Classes="app-row-action"
                      Margin="4,0,4,0"
                      IsEnabled="{Binding CanTogglePause}"
                      ToolTip.Tip="Остановить время партии" />
              <Button x:Name="DesktopAbortButton"
                      Grid.Column="2"
                      Content="Отменить партию"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanAbortGame}"
                      ToolTip.Tip="Прекратить партию и вернуть доску в исходное состояние" />
            </Grid>

            <!-- Состояние партии: кто ходит и что происходит. Итог называет баннер, поэтому
                 здесь его нет — иначе одно и то же сообщение стояло бы дважды. -->
            <TextBlock x:Name="DesktopStatusText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DesktopScoreText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Ряд действий: пас, отмена, возврат и территория — равными долями ширины панели,
                 а не по содержимому (жалоба 2026-09-30: «перенеси кнопку территория наверх, рядом
                 с другими кнопками»; в StackPanel подпись «Начать партию» не помещалась и уезжала
                 за край — проверено живым прогоном 2026-09-30). «Начать партию» стоит отдельной
                 крупной кнопкой ниже: пять подписей в 320 точек не помещаются. -->
            <Grid x:Name="DesktopActionRow"
                  Classes="app-action-row"
                  ColumnDefinitions="*,*,*,*"
                  Margin="0,2,0,0">
              <Button x:Name="PassButton"
                      Grid.Column="0"
                      Content="Пас"
                      Classes="app-row-action primary"
                      IsEnabled="{Binding CanPlayMove}" />
              <Button x:Name="UndoButton"
                      Grid.Column="1"
                      Content="Отменить"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanUndo}" />
              <Button x:Name="RedoButton"
                      Grid.Column="2"
                      Content="Вернуть"
                      Classes="app-row-action"
                      IsEnabled="{Binding CanRedo}" />
              <!-- Переключатель остаётся в ряду И КОГДА НЕДОСТУПЕН: скрытая кнопка оставляла бы
                   четвёртую колонку пустой и ряд выглядел бы сломанным (жалоба 2026-10-02).
                   Доступность — отдельный признак модели. -->
              <ToggleButton x:Name="TerritoryButton"
                            Grid.Column="3"
                            Content="Территория"
                            Classes="app-toggle"
                            ToolTip.Tip="Показать, кому принадлежат пустые точки"
                            IsEnabled="{Binding CanToggleTerritory}"
                            IsChecked="{Binding ShowTerritory}" />
            </Grid>

            <!-- Числа подсчёта стоят сразу под действиями: игрок нажимает «Территорию» и обязан
                 видеть рядом, что именно посчитано — камни, территория, пленные. Пустые строки
                 места не занимают: их скрывает вид по признаку «есть что сказать». -->
            <TextBlock x:Name="DesktopPrisonersText"
                       Classes="app-value"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <TextBlock x:Name="DesktopBreakdownText"
                       Classes="app-label"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!-- Списки доски и уровня: ими игрок выбирает, с чем играть, поэтому они видны
                 всегда. Списки заполняет код вида (BoardView.axaml.cs), а не привязка: список
                 выбора сбрасывает индекс при подмене ItemsSource и вернул бы его в модель
                 представления, из-за чего партия начиналась не с выбранным уровнем. -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Доска" VerticalAlignment="Center" />
              <ComboBox x:Name="SizeBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Уровень" VerticalAlignment="Center" />
              <ComboBox x:Name="LevelBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Сообщения о сохранении, загрузке и отказах: на телефоне системных диалогов нет.
                 Строка исчезает сама через несколько секунд (BoardView.axaml.cs). -->
            <TextBlock x:Name="Hint"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- Подробности свёрнуты по умолчанию: соперник, ход, коми, разбор счёта и подсказка
                 об уровнях — то, что нужно не каждый ход. Содержимое обязано быть: кнопка,
                 раскрывающая пустую панель, выглядит сломанной (жалоба пользователя 2026-10-02). -->
            <ToggleButton x:Name="DesktopDetailsButton"
                          Content="Подробности"
                          Classes="app-toggle"
                          Margin="0,2,0,0"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />

            <StackPanel x:Name="DesktopDetailsPanel" Spacing="6" IsVisible="False">
              <!-- Сведения о партии одной строкой: соперник, номер хода и коми. -->
              <TextBlock x:Name="DesktopStatsText"
                         Classes="app-label"
                         TextWrapping="Wrap" />

              <!-- Разбор обеих систем словами: он нужен тому, кто проверяет счёт, а не тому,
                   кто играет. Отдельное имя: строка короткого счёта стоит выше и заполняется
                   тем же текстом, но живёт всегда. -->
              <TextBlock x:Name="DesktopScoreSystemsText"
                         Classes="app-label"
                         TextWrapping="Wrap" />

              <!-- Подсказка о том, почему уровней с сетью нет: строка нужна, но показывается
                   только когда есть что сказать. -->
              <TextBlock x:Name="DesktopLevelHintText"
                         Classes="app-label"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- Главное действие партии — отдельной крупной кнопкой во всю ширину панели.
                 В ряду действий подпись «Начать партию» не помещалась: пять кнопок на 320 точек
                 панели обрезали её (проверено живым прогоном 2026-09-30). -->
            <Button x:Name="NewGameButton"
                    Content="Начать партию"
                    Classes="app-primary"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Stretch" />

            <Grid ColumnDefinitions="*,*,*">
              <Button x:Name="SettingsButton"
                      Content="Настройки…"
                      MinHeight="40"
                      Margin="0,0,3,0"
                      ToolTip.Tip="Размер доски, уровень AI, цвет игрока и коми"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="SaveButton"
                      Grid.Column="1"
                      Content="Сохранить"
                      MinHeight="40"
                      Margin="3,0,3,0"
                      ToolTip.Tip="Сохранить партию в файл SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button x:Name="LoadButton"
                      Grid.Column="2"
                      Content="Загрузить"
                      MinHeight="40"
                      Margin="3,0,0,0"
                      ToolTip.Tip="Загрузить партию из файла SGF"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>

    <!-- Мобильная раскладка: доска занимает экран, действия — под ней, состояние и подробности —
         в шторке снизу с ручкой. Строки итога здесь больше нет: баннер итога один на обе раскладки
         и стоит оверлеем по центру экрана (жалоба пользователя 2026-10-02). -->
    <Grid x:Name="MobileLayout"
          IsVisible="False"
          RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource AppBoardBackdropBrush}">

      <!-- Шапка телефона: действия партии слева, кто ходит и время — в середине, «Пауза» справа.
           Вход в меню партии (☰) и в «Настройку партии» (шестерёнка) стоят в шапке, а не в ряду
           действий: ряд под доской занят ходом партии, а эти действия редкие и должны быть
           под рукой в одно касание (замечание пользователя 2026-10-06).

           Высота целей нажатия — 44 точки, отступы сжаты до 2: строка состояния обязана остаться
           короткой, иначе доска теряет место (AppStatusHeight). Подписи в строке обрезаются
           многоточием: подробности (счёт, пленные, коми) живут в шторке. -->
      <Border Grid.Row="0"
              x:Name="MobileStatus"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="6,2"
              MinHeight="{DynamicResource AppStatusHeight}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <Button x:Name="MobileMenuButton"
                  Classes="app-icon"
                  AutomationProperties.Name="Меню партии"
                  ToolTip.Tip="Новая партия, файлы и настройка партии">
            <!-- Три точки, а не «три полосы»: полосы стоят у раздела «Меню» в нижней навигации,
                 и одинаковые значки путали игрока — он ждал от кнопки партии то же самое, что
                 от раздела приложения (замечание пользователя 2026-10-07). -->
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M12,4.6 A2.3,2.3 0 1 1 12,9.2 A2.3,2.3 0 1 1 12,4.6 Z M12,9.7 A2.3,2.3 0 1 1 12,14.3 A2.3,2.3 0 1 1 12,9.7 Z M12,14.8 A2.3,2.3 0 1 1 12,19.4 A2.3,2.3 0 1 1 12,14.8 Z" />
          </Button>

          <Button x:Name="MobileSettingsButton"
                  Grid.Column="1"
                  Classes="app-icon"
                  AutomationProperties.Name="Настройка партии"
                  ToolTip.Tip="Размер доски, уровень AI, цвет игрока, коми и подсчёт">
            <!-- Шестерёнка: диск, восемь зубцов и вырез в середине. Все части нарисованы
                 по часовой стрелке, вырез — против: правило заливки Nonzero (F1) вычитает
                 только встречную фигуру, и отверстие получается дыркой, а не вторым диском. -->
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,8.4 A3.6,3.6 0 1 0 12,15.6 A3.6,3.6 0 1 0 12,8.4 Z M10.6,1.6 h2.8 v4.4 h-2.8 z M10.6,18 h2.8 v4.4 h-2.8 z M1.6,10.6 h4.4 v2.8 h-4.4 z M18,10.6 h4.4 v2.8 h-4.4 z M17.2,3.4 L20.6,6.8 L17.2,10.2 L13.8,6.8 Z M6.8,3.4 L10.2,6.8 L6.8,10.2 L3.4,6.8 Z M6.8,13.8 L10.2,17.2 L6.8,20.6 L3.4,17.2 Z M17.2,13.8 L20.6,17.2 L17.2,20.6 L13.8,17.2 Z" />
          </Button>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      Margin="4,0,6,0"
                      VerticalAlignment="Center">
            <!-- Камень того, кто ходит: чёрный залит, белый — с обводкой, иначе он пропадал бы
                 на светлой строке состояния. -->
            <Panel VerticalAlignment="Center">
              <Ellipse x:Name="MobileTurnBlack"
                       Width="14"
                       Height="14"
                       Fill="{DynamicResource AppTextBrush}" />
              <Ellipse x:Name="MobileTurnWhite"
                       Width="14"
                       Height="14"
                       IsVisible="False"
                       Fill="{DynamicResource AppSurfaceBrush}"
                       Stroke="{DynamicResource AppTextMutedBrush}"
                       StrokeThickness="1" />
            </Panel>
            <TextBlock x:Name="MobileTurnText"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <TextBlock x:Name="MobileClockText"
                     Grid.Column="3"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Classes="app-clock"
                     TextTrimming="CharacterEllipsis" />
          <Button x:Name="MobilePauseButton"
                  Grid.Column="4"
                  Content="Пауза"
                  MinWidth="76"
                  VerticalAlignment="Center"
                  Classes="app-action"
                  IsEnabled="{Binding CanTogglePause}" />
        </Grid>
      </Border>

      <!-- Доска и панель действий.
           Доска и панель занимают РАЗНЫЕ строки сетки: панель действий не плавает поверх доски,
           и нижние ряды не уходят под кнопки — на телефоне это было видно сразу (живой прогон
           2026-09-30, эмулятор API 35). Между ними гарантированный зазор: верхний отступ панели
           плюс поля доски внутри её строки. Полоса «Проверьте пометки… Посчитать» убрана:
           оценка приходит сама, и просить игрока подтверждать её кнопкой больше не нужно
           (жалоба пользователя 2026-10-02). -->
      <Grid Grid.Row="1" RowDefinitions="*,Auto">
        <Panel x:Name="MobileBoardRow" Grid.Row="0">
          <Border x:Name="MobileBoardHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
      </Panel>

      <!-- Панель действий: один ряд, и в нём — только ход партии: пас, отмена, возврат
           и разметка территории. Часы и «Пауза» стоят в шапке, «Новая партия», «Отменить партию»,
           файлы и настройки переехали в меню (кнопка «Меню» в нижней навигации): в 360 точках
           пять кнопок в ряд не помещались (жалоба пользователя 2026-10-02), а теперь ряд стал
           ровным и компактным.
           Панель идёт во всю ширину доски, а не «плавающей» карточкой по центру: раньше её ширина
           зависела от подписей, она была уже доски и заезжала за нижний край (жалоба 2026-10-02
           «наезжает на доску и сделан не аккуратно»). Ширину ограничивает код вида
           (BoardLayoutRules.MobileActionBarWidth): по ширине доски, но не уже читаемой.
           Верхний отступ — гарантированный зазор между доской и панелью. -->
      <Border x:Name="MobileActionBar"
              Grid.Row="1"
              Classes="app-card"
              Padding="8"
              Margin="8,8,8,8"
              HorizontalAlignment="Stretch">
            <Grid x:Name="MobileActionRow" ColumnDefinitions="*,*,*,*" Classes="app-touch-row touch">
              <Button x:Name="MobilePassButton"
                      Grid.Column="0"
                      Content="Пас"
                      Classes="app-touch primary"
                      IsEnabled="{Binding CanPlayMove}" />
              <Button x:Name="MobileUndoButton"
                      Grid.Column="1"
                      Content="Отменить"
                      Classes="app-touch"
                      IsEnabled="{Binding CanUndo}" />
              <Button x:Name="MobileRedoButton"
                      Grid.Column="2"
                      Content="Вернуть"
                      Classes="app-touch"
                      IsEnabled="{Binding CanRedo}" />
              <!-- Переключатель остаётся в ряду и тогда, когда недоступен: скрытая кнопка
                   оставляла четвёртую колонку пустой, и ряд выглядел сломанным (жалоба
                   пользователя 2026-10-02; после конца партии «Территория» доступна —
                   признак CanToggleTerritory у модели). -->
              <ToggleButton x:Name="MobileTerritoryButton"
                            Grid.Column="3"
                            Content="Территория"
                            Classes="app-touch-toggle"
                            IsEnabled="{Binding CanToggleTerritory}"
                            IsChecked="{Binding ShowTerritory}" />
            </Grid>
      </Border>
      </Grid>

      <!-- Шторка сведений: свёрнута — короткое состояние, развёрнута — подробности.
           Ручка и строка состояния вместе дают цель нажатия выше 48 точек. -->
      <Border x:Name="Sheet"
              Grid.Row="2"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="18,18,0,0">
        <StackPanel>

          <Button x:Name="SheetToggleButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="12,6"
                  MinHeight="{DynamicResource AppTouchTarget}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Подробности партии">
            <StackPanel Spacing="6">
              <Border Width="40"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource AppBorderBrush}" />
              <!-- Строки краткого состояния: на низком экране (телефон в ландшафте) они
                   убираются, чтобы доска не стала полоской. -->
              <StackPanel x:Name="SheetSummaryPanel" Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SheetSummary"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SheetChevron"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Classes="app-label"
                           VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="SheetSummaryDetails"
                         Classes="app-label"
                         TextWrapping="Wrap" />
              <!-- Сообщения о сохранении, загрузке и отказах видны и в свёрнутой шторке:
                   на телефоне системных диалогов нет. -->
              <TextBlock x:Name="MobileHint"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />
              </StackPanel>
            </StackPanel>
          </Button>

          <ScrollViewer x:Name="SheetDetails"
                        IsVisible="False"
                        MaxHeight="380"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,12" Spacing="8">

              <TextBlock Classes="app-subtitle" Text="Подробности" />

              <TextBlock x:Name="MobileStatusText" Classes="app-value" />

              <!-- Здесь остаётся только объяснение счёта и статус: строка счёта (SheetSummary)
                   и пленные (SheetSummaryDetails) уже стоят в свёрнутой шторке, и повторять их
                   в подробностях нельзя — игрок видел одну и ту же величину дважды (жалоба
                   пользователя 2026-10-02 «дублирование счетов»). -->
              <TextBlock x:Name="MobileScoreDetailText" Classes="app-label" TextWrapping="Wrap" />

              <!-- Числа разметки видны всегда: переключатель «Территория» показывает и прячет
                   картинку на доске, а не счёт (D-071, замечание пользователя 2026-10-03).
                   Видимость строки ставит код вида по признаку «есть что сказать» — так же,
                   как у настольной строки разбора. -->
              <TextBlock x:Name="MobileBreakdownText"
                         Classes="app-label"
                         TextWrapping="Wrap"
                         IsVisible="False" />

              <TextBlock x:Name="MobileStatsText" Classes="app-label" TextWrapping="Wrap" />

              <TextBlock Classes="app-label"
                         Text="{Binding LevelHint}"
                         IsVisible="{Binding HasLevelHint}"
                         FontStyle="Italic" />

              <WrapPanel>
                <Button x:Name="MobileSaveButton"
                        Content="Сохранить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <Button x:Name="MobileLoadButton"
                        Content="Загрузить"
                        Classes="app-action"
                        Margin="0,0,6,6" />
                <!-- «Настройка партии» открывается шестерёнкой в шапке и строкой меню партии:
                     третий вход в подробностях был бы лишним (замечание 2026-10-06). -->
              </WrapPanel>

            </StackPanel>
          </ScrollViewer>

        </StackPanel>
      </Border>

    </Grid>

    <!-- Меню партии: шторка снизу. Сюда переехали действия, которые на телефоне не помещаются
         в ряд под доской: «Начать партию»/«Новая партия», «Отменить партию», файлы и «Настройка
         партии» (замечание пользователя 2026-10-03), а сама карточка по центру заменена шторкой —
         она ближе к большому пальцу и не закрывает доску целиком (замечание 2026-10-06).
         Открывает шторку кнопка ☰ в шапке партии; закрывается нажатием по затемнению, свайпом вниз
         по ручке и строкой «Закрыть». Сама шторка лежит в слое затемнения: нажатие мимо неё
         попадает в подложку и закрывает меню. -->
    <Border x:Name="MenuOverlay"
            IsVisible="False">
      <Panel>
        <!-- Затемнение: кнопка во весь слой. Кнопка, а не рамка, потому что нажатие должно
             закрывать меню и на телефоне, где указателя нет. -->
        <Button x:Name="MenuBackdrop"
                Classes="app-backdrop"
                AutomationProperties.Name="Закрыть меню партии" />

        <Border x:Name="MenuCard"
                Classes="app-sheet"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">
          <StackPanel>

            <!-- Ручка шторки: за неё шторка тянется вниз и закрывается. Полоса нажатия выше
                 самого штриха — по тонкой линии палец не попадёт. -->
            <Border x:Name="MenuSheetHandle"
                    Background="Transparent"
                    Padding="0,8,0,2"
                    MinHeight="28">
              <Border Width="40"
                      Height="4"
                      CornerRadius="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AppBorderBrush}" />
            </Border>

            <TextBlock Classes="app-subtitle"
                       Text="Меню партии"
                       HorizontalAlignment="Center"
                       Margin="12,2,12,8" />

            <!-- Подпись главного действия меняет код вида: до первого хода — «Начать партию»,
                 после — «Новая партия» (та же логика, что и в настольной панели). -->
            <Button x:Name="MenuNewGameButton"
                    Classes="app-menu-row primary"
                    AutomationProperties.Name="Начать партию">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Камень: игра начинается с хода чёрных. -->
                <Path Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z" />
                <TextBlock x:Name="MenuNewGameText"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Начать партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuAbortButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Отменить партию"
                    IsEnabled="{Binding CanAbortGame}">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Перечёркнутый круг: партия прекращается, доска возвращается в исходное
                     состояние. Крест остаётся только у строки «Закрыть» — два одинаковых
                     креста в одной шторке путали игрока (замечание пользователя 2026-10-07). -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M6.2,8.4 L8.4,6.2 L17.8,15.6 L15.6,17.8 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Отменить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuSaveButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Сохранить партию">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Дискета: сохранение партии в файл SGF. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M4,4 h13 l3,3 v13 h-16 z M8,4 h8 v6 h-8 z M7,14 h10 v6 h-10 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Сохранить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuLoadButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Загрузить партию">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Папка: загрузка партии из файла SGF. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M3,5 h6.5 l2,2 h9.5 v12 h-18 z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Загрузить партию"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="MenuSettingsButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Настройка партии">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Та же шестерёнка, что и в шапке: «Настройка партии» — один и тот же экран. -->
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,8.4 A3.6,3.6 0 1 0 12,15.6 A3.6,3.6 0 1 0 12,8.4 Z M10.6,1.6 h2.8 v4.4 h-2.8 z M10.6,18 h2.8 v4.4 h-2.8 z M1.6,10.6 h4.4 v2.8 h-4.4 z M18,10.6 h4.4 v2.8 h-4.4 z M17.2,3.4 L20.6,6.8 L17.2,10.2 L13.8,6.8 Z M6.8,3.4 L10.2,6.8 L6.8,10.2 L3.4,6.8 Z M6.8,13.8 L10.2,17.2 L6.8,20.6 L3.4,17.2 Z M17.2,13.8 L20.6,17.2 L17.2,20.6 L13.8,17.2 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Настройка партии"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Border Classes="app-divider" Margin="14,4" />

            <Button x:Name="MenuCloseButton"
                    Classes="app-menu-row"
                    AutomationProperties.Name="Закрыть меню">
              <Grid ColumnDefinitions="Auto,*">
                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Data="M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Закрыть"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>

          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Итог партии — один на обе раскладки, оверлеем поверх вида: затемнение и карточка
         по центру экрана. Раньше баннеров было два (по одному на раскладку), и оба стояли полосой
         сверху — на телефоне полоса оказывалась отдельной строкой сетки, уезжала от взгляда
         и теснила доску (жалоба пользователя 2026-10-02). Стоит до экрана настроек: настройки
         открываются поверх всего. -->
    <views:GameResultBanner x:Name="ResultBanner" />

    <!-- Настройки — полноценный экран во всю высоту вида, а не карточка: подразделов три,
         и в карточке 460×640 они не помещались (жалоба пользователя 2026-10-03). Сверху заголовок,
         внизу — «Сохранить» и «Отмена» из самого вида настроек. На настольной раскладке те же
         настройки показывает окно (SettingsWindow) — этот экран там не открывается. -->
    <Border x:Name="SettingsOverlay"
            IsVisible="False"
            Background="{DynamicResource AppBackgroundBrush}">
      <Border x:Name="SettingsCard"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource AppBackgroundBrush}">
        <Grid RowDefinitions="Auto,*">
          <Border x:Name="SettingsHeader"
                  Grid.Row="0"
                  Padding="10,8"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,0,1">
            <TextBlock x:Name="SettingsTitle"
                       Classes="app-subtitle"
                       Text="Настройка партии"
                       VerticalAlignment="Center" />
          </Border>

          <!-- Прокрутка и низ экрана — внутри самого вида настроек: общий вид сам делит место
               между подразделами и кнопками «Сохранить»/«Отмена». -->
          <views:SettingsView x:Name="SettingsArea" Grid.Row="1" />
        </Grid>
      </Border>
    </Border>

  </Panel>
</UserControl>
