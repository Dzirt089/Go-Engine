<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.Views.SettingsView">

  <!-- Настройка партии двумя подразделами: «Партия» (чем играем) и «Подсчёт» (как считаются
       очки). Один и тот же вид показывают настольное окно (SettingsWindow) и мобильный экран
       во всю высоту (BoardView): логика одна. Подраздела «О программе» здесь больше нет: сведения
       о программе — не настройка партии, и на телефоне они открываются из общего меню
       (замечание пользователя 2026-10-06, DECISIONS.md D-075).
       Внизу — «Сохранить» и «Отмена»: игрок сам решает, применять ли выбор, и партию начинает
       только «Сохранить» (жалоба пользователя 2026-10-03 «не хватает кнопки сохранить и отмена»). -->
  <Grid RowDefinitions="*,Auto">

    <TabControl x:Name="SettingsTabs" Grid.Row="0" Classes="app-settings-tabs">

    <!-- Подраздел «Партия»: размер доски, уровень соперника, цвет игрока, коми и звук. -->
    <TabItem Header="Партия">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="10">

          <TextBlock Text="Размер доски" FontWeight="SemiBold" />
          <ComboBox x:Name="SizeBox" HorizontalAlignment="Stretch" MinHeight="44" />

          <TextBlock Text="Уровень AI" FontWeight="SemiBold" />
          <ComboBox x:Name="LevelBox" HorizontalAlignment="Stretch" MinHeight="44" />

          <TextBlock Text="Мой цвет" FontWeight="SemiBold" />
          <ComboBox x:Name="ColorBox" HorizontalAlignment="Stretch" MinHeight="44" />

          <TextBlock Text="Коми" FontWeight="SemiBold" />
          <NumericUpDown x:Name="KomiBox"
                         Minimum="0"
                         Maximum="20"
                         Increment="0.5"
                         FormatString="0.0"
                         MinHeight="44"
                         HorizontalAlignment="Stretch" />

          <!-- Звук ходов: короткий стук камня вместе с анимацией. Игрок вправе его выключить —
               в турнирном зале, в транспорте или просто потому, что не нужен. -->
          <CheckBox x:Name="SoundBox"
                    Content="Звук ходов"
                    MinHeight="44"
                    IsChecked="True" />

          <!-- Подсказка о том, что делает «Сохранить»: без неё игрок не понимает, почему доска
               не изменилась, а уровень соперника сменился (жалоба пользователя 2026-10-03). -->
          <TextBlock x:Name="NewGameHintText"
                     Classes="app-label"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     Text="«Сохранить» применяет выбор: уровень AI начинает играть со следующего хода соперника, а новый размер доски, цвет или коми начинают новую партию. «Отмена» закрывает настройки, ничего не меняя. Правило подсчёта и звук действуют сразу." />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Подраздел «Подсчёт»: какая система называет победителя и что входит в очки.
         Пояснения берутся у самих правил (ScoringRule.Descriptions) и из подсказки
         MainViewModel.ScoringHint — своих формулировок правил вид не придумывает. -->
    <TabItem Header="Подсчёт">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="10">

          <TextBlock Text="Система подсчёта" FontWeight="SemiBold" />
          <ComboBox x:Name="ScoringBox" MinHeight="44" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="320" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Пояснение к выбранной системе: строка меняется вместе с выбором. -->
          <TextBlock x:Name="ScoringHintText" TextWrapping="Wrap" />

          <TextBlock Text="Японская система (для РФ)" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock x:Name="JapaneseText" Classes="app-label" TextWrapping="Wrap" />

          <TextBlock Text="Китайская система" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock x:Name="ChineseText" Classes="app-label" TextWrapping="Wrap" />

          <TextBlock Text="Чем отличаются" FontWeight="SemiBold" Margin="0,6,0,0" />
          <TextBlock x:Name="DifferenceText" Classes="app-label" TextWrapping="Wrap" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    </TabControl>

    <!-- Низ экрана один на все подразделы: «Сохранить» применяет выбор и приводит партию
         в соответствие, «Отмена» закрывает настройки, ничего не меняя. Раньше единственным
         выходом было «Готово» в заголовке телефона, и вопрос «кто будет играть» оставался
         без ответа (жалоба пользователя 2026-10-03). -->
    <Border Grid.Row="1"
            Padding="12,8"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource AppSurfaceBrush}">
      <Grid ColumnDefinitions="*,*">
        <Button x:Name="CancelButton"
                Grid.Column="0"
                Content="Отмена"
                Classes="app-action"
                Margin="0,0,4,0"
                HorizontalAlignment="Stretch" />
        <Button x:Name="SaveButton"
                Grid.Column="1"
                Content="Сохранить"
                Classes="app-primary"
                Margin="4,0,0,0"
                IsDefault="True"
                HorizontalAlignment="Stretch" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
