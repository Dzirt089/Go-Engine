<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GoEngine.App.Controls"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">

  <!-- Разбор партии: та же доска, что в партии и уроках (BoardControl), но своя панель и модель.
       Раскладку выбирает код вида (ReviewView.axaml.cs) по BoardLayoutRules: на узком экране
       доска сверху и панель снизу, на широком — доска слева, панель справа.

       Панель собрана так же, как в уроке: сверху выбор партии и словарь, посередине разбор,
       снизу одна строка управления (замечание пользователя 2026-10-10 о нехватке места).
       Ходы партии играет модель (<see cref="ReviewViewModel"/>), а не вид.

       Все надписи — на русском: обучение ведётся по-русски (замечание пользователя 2026-10-07). -->
  <Grid x:Name="Layout" ColumnDefinitions="*,320">

    <controls:BoardControl x:Name="Board"
                           Grid.Column="0"
                           Board="{Binding Board}"
                           LastMove="{Binding LastMove}"
                           HintPoint="{Binding HintPoint}" />

    <Border x:Name="Panel"
            Grid.Column="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1,0,0,0"
            Padding="12,10">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Шапка панели: выбор партии и словарь терминов. Не прокручивается: список партий
             должен стоять на месте, пока игрок читает разбор. -->
        <Grid x:Name="PanelHeader" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">

          <ComboBox x:Name="GameBox"
                    Grid.Column="0"
                    MinHeight="44"
                    HorizontalAlignment="Stretch" />

          <Button x:Name="GlossaryButton"
                  Grid.Column="1"
                  Classes="app-icon"
                  Margin="6,0,0,0"
                  AutomationProperties.Name="Словарь терминов"
                  ToolTip.Tip="Словарь терминов: объяснения и оригинальные названия">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="F1 M3,5 L11,7 L11,20.4 L3,18.4 Z M13,7 L21,5 L21,18.4 L13,20.4 Z" />
          </Button>
        </Grid>

        <!-- Разбор текущей позиции: то, ради чего партия открыта. -->
        <ScrollViewer x:Name="NoteScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4" Margin="0,0,0,8">

            <TextBlock x:Name="Heading" Text="Разбор партии" FontSize="16" FontWeight="SemiBold" />

            <TextBlock x:Name="MoveCounterText"
                       Text="{Binding MoveCounter}"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="NoteTitleText"
                       Text="{Binding NoteTitle}"
                       IsVisible="{Binding HasNote}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="NoteTextText"
                       Text="{Binding NoteText}"
                       IsVisible="{Binding HasNote}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="MessageText"
                       Text="{Binding Message}"
                       IsVisible="{Binding HasMessage}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="GameTitleText"
                       Text="{Binding GameTitle}"
                       Margin="0,8,0,0"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="GameSummaryText"
                       Text="{Binding GameSummary}"
                       Classes="app-label"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="PlayersText"
                       Text="{Binding Players}"
                       Classes="app-label"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ResultText"
                       Text="{Binding Result}"
                       Classes="app-label"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding ListCaption}"
                       Classes="app-label"
                       Margin="0,6,0,0" />

          </StackPanel>
        </ScrollViewer>

        <!-- Управление: одна строка — как в уроке. -->
        <Grid x:Name="PanelActions" Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,6,0,0">

          <Button x:Name="HintButton"
                  Classes="app-icon"
                  AutomationProperties.Name="Подсказка"
                  ToolTip.Tip="Показать ход"
                  IsEnabled="{Binding CanHint}">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M12,3.4 A5.6,5.6 0 0 1 15.2,13.6 L8.8,13.6 A5.6,5.6 0 0 1 12,3.4 Z M9.4,15.4 h5.2 v1.8 h-5.2 z M10.2,18.2 h3.6 v1.8 h-3.6 z" />
          </Button>

          <Button x:Name="BackButton"
                  Grid.Column="1"
                  Classes="app-icon"
                  AutomationProperties.Name="Назад"
                  ToolTip.Tip="Предыдущий ход"
                  IsEnabled="{Binding CanGoBack}">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="M14.6,5.2 L7.8,12 L14.6,18.8 L16.7,16.7 L12,12 L16.7,7.3 Z" />
          </Button>

          <Button x:Name="ResetButton"
                  Grid.Column="2"
                  Classes="app-icon"
                  AutomationProperties.Name="Заново"
                  ToolTip.Tip="Начать разбор заново">
            <Path Width="22" Height="22" Stretch="Uniform"
                  Data="F1 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M12,0.8 L16.4,4.8 L12,8.8 Z" />
          </Button>

          <Button x:Name="NextButton"
                  Grid.Column="3"
                  Content="Далее"
                  Classes="app-primary"
                  Margin="8,0,0,0"
                  MinHeight="44"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding CanGoNext}" />

        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
