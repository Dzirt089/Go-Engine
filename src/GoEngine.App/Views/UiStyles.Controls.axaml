<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Общие стили органов управления: ряды кнопок над доской, переключатель территории,
       чипы форм, баннер итога партии и карточки результата. Отдельный файл нужен потому,
       что UiStyles.axaml описывает базу и классы экранов, а эти правила работают в обеих
       раскладках и различаются только размерами.

       Размеры под платформу. На телефоне цель нажатия не меньше 48 точек — по этому размеру
       уверенно попадает палец (рекомендация Android Material: 48dp). На настольной версии
       ряд действий компактнее, но всё равно не ниже 44 точек: в панели 320 точек четыре
       подписи обязаны помещаться, а высота панели прокручивается. Размеры заданы прямо здесь,
       а не через DynamicResource AppTouchTarget: мобильные кнопки получают 48 из того ресурса,
       настольные — своё значение, и одно не переопределяет другое.

       Цвета — только из темы (UiTheme.axaml): светлая и тёмная темы переключаются без правки
       этого файла. -->

  <!-- ==================================================================================== -->
  <!-- РЯД ДЕЙСТВИЙ НАД ДОСКОЙ                                                              -->
  <!-- ==================================================================================== -->

  <Style Selector="Button.app-row-action">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusSmall}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.app-row-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.app-row-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.app-row-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Главное действие ряда: пас — акцентная кнопка. -->
  <Style Selector="Button.app-row-action.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.app-row-action.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Button.app-row-action.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Button.app-row-action.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Ряд кнопок над доской на телефоне: четыре действия по 360 точкам экрана.
       Доли ширины заданы в разметке (Grid ColumnDefinitions), а не стилем: ColumnDefinitions —
       не AvaloniaProperty, и присвоить её через Setter нельзя (проверено сборкой — AVLN3000).
       Расстояние между кнопками — отступом самих кнопок: ColumnSpacing у Grid в Avalonia 11.2
       тоже нет (AVLN2000). -->
  <Style Selector="Grid.app-touch-row.touch > Button, Grid.app-touch-row.touch > ToggleButton">
    <Setter Property="Margin" Value="3,0" />
  </Style>

  <!-- Настольный ряд действий: кнопки делят ширину панели и стоят вплотную, различает их рамка.
       Расстояние между ними задано рамкой, а не отступом: четыре кнопки на 320 точках — это
       по 80 точек на каждую, и лишние отступы съедали подписи. -->
  <Style Selector="Grid.app-action-row > Button, Grid.app-action-row > ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Высота 64, а не 48: на Android отрисовка смещена вниз примерно на 24 точки относительно
       областей нажатия (вставка статус-бара), и при высоте 48 тап в центр приходился ровно
       на границу кнопки — срабатывала только кромка (блокер B1 из отчёта QA 2026-10-17).
       С 64 точками смещение уходит в запас, а цель нажатия становится только удобнее. -->
  <Style Selector="Button.app-touch">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.app-touch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.app-touch:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.app-touch:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.app-touch.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.app-touch.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Button.app-touch.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Button.app-touch.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ==================================================================================== -->
  <!-- ПЕРЕКЛЮЧАТЕЛИ                                                                        -->
  <!-- ==================================================================================== -->

  <!-- Переключатель территории: цель 44 точки. Включённое состояние обязано быть видно.
       Без этой подсветки игрок не понимал, включена разметка территории или нет
       (жалоба 2026-09-30): серый ToggleButton в нажатом и в обычном состоянии выглядел
       одинаково. -->
  <Style Selector="ToggleButton.app-toggle">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Подсветка включённого состояния ставится части шаблона, а не самой кнопке: Fluent рисует
       фон и рамку на ContentPresenter#PART_ContentPresenter внутри шаблона ToggleButton, поэтому
       Background на кнопке не виден вовсе. Проверено по исходнику Avalonia 11.2.1
       (Controls/ToggleButton.xaml: внутри ^:checked стоит ^ /template/ ContentPresenter).
       Полужирная подпись остаётся на самой кнопке: шрифт шаблон не переопределяет. -->
  <Style Selector="ToggleButton.app-toggle:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-toggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-touch-toggle">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.app-touch-toggle:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.app-touch-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.app-touch-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- ==================================================================================== -->
  <!-- ЧИПЫ ФОРМ РЕШЕНИЯ                                                                    -->
  <!-- ==================================================================================== -->

  <!-- Чип формы решения: компактная кнопка в горизонтальной полосе. Минимальная высота 36 точек —
       палец уверенно попадает, а полоса не съедает место у доски (замечание пользователя
       2026-10-11). Форма — «таблетка»: мягкие круглые подложки, как у значков главного экрана. -->
  <Style Selector="Button.app-chip">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
  </Style>

  <Style Selector="Button.app-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <!-- Выбранный чип формы: без него на доске видно подсветку, но не видно, какая форма
       активна, а на телефоне подсветка может уехать за край экрана (D-116). Background
       и рамку рисует ContentPresenter шаблона Fluent, а не сама кнопка: та же причина,
       что у ToggleButton.app-toggle:checked. Кегль и вес шрифта не меняются: иначе выбранный
       чип менял бы ширину и переносился на узкой панели. -->
  <Style Selector="Button.app-chip.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Button.app-chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <!-- Чип формы на телефоне: палец должен попадать в кнопку, а 36 точек меньше рекомендованных
       48 dp — и это одна из возможных причин жалобы «переключение не работает» на Android
       (D-116). Класс narrow ставит раскладка «доска и панель» на узком экране. -->
  <Style Selector="Border.narrow Button.app-chip">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <!-- ==================================================================================== -->
  <!-- СООБЩЕНИЯ ПАНЕЛИ                                                                     -->
  <!-- ==================================================================================== -->

  <!-- Сообщение панели: похвала или отказ. Цвет из темы, поэтому DynamicResource. -->
  <Style Selector="TextBlock.message-good">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.message-bad">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ==================================================================================== -->
  <!-- БАННЕР И КАРТОЧКА ИТОГА                                                              -->
  <!-- ==================================================================================== -->

  <!-- Баннер итога партии: заметная карточка над доской. Цвет ставит код вида по признаку
       «выиграл / проиграл / ничья»: игроку важно не «победили чёрные», а выиграл он сам. -->
  <Style Selector="Border.app-banner">
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusMedium}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
  </Style>

  <!-- Карточка результата в панели: та же поверхность, что у баннера, плюс мягкая тень —
       итог должен читаться как отдельный блок, а не как ещё одна строка текста. Тона
       (result-win/loss/draw) задаёт код вида ниже; здесь только форма. -->
  <Style Selector="Border.result-card">
    <Setter Property="BoxShadow" Value="{DynamicResource AppShadowCard}" />
  </Style>

  <Style Selector="Border.app-banner.result-win">
    <Setter Property="Background" Value="{DynamicResource AppWinSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppWinBorderBrush}" />
  </Style>

  <Style Selector="Border.app-banner.result-loss">
    <Setter Property="Background" Value="{DynamicResource AppLoseSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppLoseBorderBrush}" />
  </Style>

  <Style Selector="Border.app-banner.result-draw">
    <Setter Property="Background" Value="{DynamicResource AppDrawSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDrawBorderBrush}" />
  </Style>

  <Style Selector="TextBlock.app-banner-title">
    <Setter Property="FontSize" Value="{DynamicResource AppFontHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.app-banner.result-win TextBlock.app-banner-title">
    <Setter Property="Foreground" Value="{DynamicResource AppWinTextBrush}" />
  </Style>

  <Style Selector="Border.app-banner.result-loss TextBlock.app-banner-title">
    <Setter Property="Foreground" Value="{DynamicResource AppLoseTextBrush}" />
  </Style>

  <Style Selector="TextBlock.app-banner-detail">
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Button.app-banner-action">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontAction}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.app-banner-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.app-banner-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <!-- Кнопка баннера на телефоне: класс touch ставит сам баннер, когда раскладка мобильная.
       Отдельный класс, а не порядок файлов: на мобильный размер не должна влиять очерёдность
       включения стилей — она уже один раз чуть не превратила настольную кнопку в мобильную. -->
  <Style Selector="Button.app-banner-action.touch">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontSize" Value="{DynamicResource AppFontBody}" />
    <Setter Property="Padding" Value="18,0" />
  </Style>

  <Style Selector="Button.app-banner-action.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.app-banner-action.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Button.app-banner-action.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <!-- ==================================================================================== -->
  <!-- ЧАСЫ ПАРТИИ                                                                          -->
  <!-- ==================================================================================== -->

  <!-- Время партии: цифры стоят рядом с кнопками, и время обязано читаться с одного взгляда.
       Кегль крупнее подписи и полужирный: в этой строке главное — время, а не пояснение.
       Стиль общий для настольной панели и телефона: строки времени одинаковы, различается
       только раскладка вокруг них. -->
  <Style Selector="TextBlock.app-clock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
