<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.Views.AboutView">

  <!-- «О программе»: версия, модели нейросети, логи, сбой прошлого запуска и обновление.
       Раньше это был третий подраздел настроек, но настройки принадлежат партии, а сведения
       о программе — приложению: на телефоне экран открывается из общего меню, в настольном окне —
       пунктом меню «Справка» (замечание пользователя 2026-10-06; DECISIONS.md, D-075).

       Обновления: версия видна всегда, проверка и установка — по кнопке. Проверка ходит
       за манифестом в плавающий релиз latest, установка отличается от системы к системе.
       Состояние и ход загрузки берутся у общей модели обновления (App.Updates) — той же,
       что показывает приглашение в оболочке, поэтому числа здесь и там совпадают. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="10">

      <TextBlock x:Name="VersionText" Classes="app-value" />

      <!-- Состояние моделей нейросети: без этой строки отказ сети виден только по отсутствию
           уровней с нейросетью, и причину на телефоне узнать нечем. -->
      <TextBlock x:Name="ModelsText" Classes="app-label" TextWrapping="Wrap" />

      <!-- Логи: путь виден всегда, папку открывает настольная голова — на телефоне открывать
           нечего. -->
      <TextBlock x:Name="LogsText" Classes="app-label" TextWrapping="Wrap" />

      <!-- Сбой прошлого запуска: показывается один раз, копия лога остаётся в каталоге логов. -->
      <TextBlock x:Name="CrashText"
                 Foreground="{DynamicResource AppDangerBrush}"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <Button x:Name="OpenLogsButton"
              Content="Открыть папку с логами"
              Classes="app-action"
              HorizontalAlignment="Left"
              IsVisible="False" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Classes="app-action" />
        <Button x:Name="InstallUpdateButton"
                Content="Скачать и установить"
                Classes="accent"
                IsVisible="False" />
        <Button x:Name="CancelUpdateButton" Content="Отмена" Classes="app-action" IsVisible="False" />
      </StackPanel>

      <!-- Ход загрузки и установки: та же полоса, что и в приглашении оболочки, — состояние одно
           на приложение, поэтому проценты здесь и там совпадают. -->
      <ProgressBar x:Name="UpdateProgressBar"
                   Minimum="0"
                   Maximum="100"
                   Height="8"
                   IsVisible="False" />

      <TextBlock x:Name="UpdateStatusText" Classes="app-label" TextWrapping="Wrap" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
