<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoEngine.App.Views"
        x:Class="GoEngine.App.Views.SettingsWindow"
        Title="Настройки партии"
        Width="440"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- Окно — тонкая обёртка вокруг общего вида настроек: тот же SettingsView показывает
       мобильная версия во всю высоту, потому что окон на телефоне нет. Высота задана, а не
       подбирается по содержимому: подразделы разной высоты, и окно дёргалось бы при переключении.
       Закрытие окна означает согласие — кнопок «Отмена» и «Начать партию» в настройках нет. -->
  <views:SettingsView x:Name="SettingsArea" />

</Window>
