<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoEngine.App.Views"
        x:Class="GoEngine.App.Views.SettingsWindow"
        Title="Настройки партии"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- Окно — тонкая обёртка вокруг общего вида настроек: тот же SettingsView показывает
       мобильная версия поверх доски, потому что окон на телефоне нет. -->
  <views:SettingsView x:Name="SettingsArea" />

</Window>
