<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GoEngine.App.Views.SettingsWindow"
        Title="Настройки партии"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="10">

    <TextBlock Text="Размер доски" FontWeight="SemiBold" />
    <ComboBox x:Name="SizeBox" HorizontalAlignment="Stretch" />

    <TextBlock Text="Уровень AI" FontWeight="SemiBold" />
    <ComboBox x:Name="LevelBox" HorizontalAlignment="Stretch" />

    <TextBlock Text="Мой цвет" FontWeight="SemiBold" />
    <ComboBox x:Name="ColorBox" HorizontalAlignment="Stretch" />

    <TextBlock Text="Коми" FontWeight="SemiBold" />
    <NumericUpDown x:Name="KomiBox"
                   Minimum="0"
                   Maximum="20"
                   Increment="0.5"
                   FormatString="0.0"
                   HorizontalAlignment="Stretch" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Отмена" />
      <Button x:Name="StartButton" Content="Начать партию" IsDefault="True" />
    </StackPanel>

  </StackPanel>

</Window>
