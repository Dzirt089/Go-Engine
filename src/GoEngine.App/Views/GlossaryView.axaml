<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.GlossaryView"
             x:DataType="vm:GlossaryViewModel">

  <!-- Словарь терминов Го, которые встречаются в обучении. Объяснения — на русском, оригинальное
       название (японское или китайское) стоит рядом как справка: обучение ведётся по-русски,
       а термины игрок всё равно услышит и на них (замечание пользователя 2026-10-07).

       Список виртуализован (ListBox со своим ScrollViewer): на телефоне с экраном 120 Гц
       прокрутка обычного списка из двух десятков абзацев с переносами «фризила» — кадры уходили
       на перерисовку всего содержимого сразу. ListBox держит на экране только видимые строки,
       поэтому прокрутка идёт ровно, сколько бы терминов ни добавили (замечание 2026-10-07
       о быстрых экранах). Строки при этом не выбираются и не подсвечиваются: словарь читают,
       а не выбирают. -->
  <ListBox x:Name="TermsList"
           ItemsSource="{Binding Terms}"
           Background="Transparent"
           BorderThickness="0"
           Padding="16,12"
           Focusable="False"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <!-- Панель с виртуализацией: держит в дереве только видимые строки. -->
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>

    <ListBox.Styles>
      <!-- Строка словаря — просто текст: ни рамки, ни подсветки наведения, ни фокуса.
           Нажатий строка не ловит вовсе, поэтому жест прокрутки доходит до списка целиком. -->
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
      </Style>
    </ListBox.Styles>

    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:GlossaryLine">
        <StackPanel Spacing="2">

          <!-- Название и оригинал в одну строку: русское слово первым, оригинал — справкой. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Original}"
                       Classes="app-label"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />

          <TextBlock Text="{Binding Lessons}"
                     Classes="app-label"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Lessons, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
