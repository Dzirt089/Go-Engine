<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.GlossaryView"
             x:DataType="vm:GlossaryViewModel">

  <!-- Словарь терминов Го, которые встречаются в обучении. Объяснения — на русском, оригинальное
       название (японское или китайское) стоит рядом как справка: обучение ведётся по-русски,
       а термины игрок всё равно услышит и на них (замечание пользователя 2026-10-07).
       Список собирает модель (GlossaryViewModel), вид только рисует строки. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Terms}" Margin="16,12">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GlossaryLine">
          <StackPanel Margin="0,0,0,14" Spacing="2">

            <!-- Название и оригинал в одну строку: русское слово первым, оригинал — справкой. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Original}"
                         Classes="app-label"
                         VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />

            <TextBlock Text="{Binding Lessons}"
                       Classes="app-label"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Lessons, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
