<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GoEngine.App.Views"
             xmlns:vm="clr-namespace:GoEngine.App.ViewModels"
             x:Class="GoEngine.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Оболочка приложения: главный экран, партия и обучение; общее меню — не игровой режим.
       Режимы не смешиваются, оболочка только показывает один из них; содержимое создаётся кодом
       вида (ShellView.axaml.cs), чтобы виды получали свои модели из одного места и не
       пересоздавались при переключении.

       Раскладок две. На широком экране (760 точек и больше) остаётся прежняя настольная:
       строка режимов сверху, содержимое под ней, а «О программе» — пункт меню окна. На телефоне
       строка режимов заменяется нижней навигацией с четырьмя разделами — «Партия с ИИ»,
       «Партия с другом», «Обучение», «Меню»; она ближе к большому пальцу, а разделы не спорят
       за верх экрана с доской. Выбор раскладки — чистая функция (BoardLayoutRules.DecideLayout),
       здесь только применяется её ответ.

       Настройки и меню партии в нижней навигации не стоят: они принадлежат партии и живут
       в её разделе — «Настройка партии» открывается из меню партии и шестерёнкой в шапке
       (замечание пользователя 2026-10-06, DECISIONS.md D-075). -->
  <Grid x:Name="Root"
        RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- Верхняя полоса: строка режимов. Приглашение обновления живёт отдельным слоем ниже
         и стоит по центру экрана: полосой сверху оно на телефоне оказывалось строкой поверх доски
         (жалоба пользователя 2026-10-02 «должно быть в центре экрана»). -->
    <Border x:Name="DesktopBar"
            Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="0,0,0,1">
      <!-- Режимы и подсказка делят строку: подсказка занимает остаток ширины и переносится,
           а не выталкивает новую кнопку за край (жалоба о наложении при добавлении режима). -->
      <Grid Margin="10,8" ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <!-- Кнопки не меньше 44 точек по высоте: это размер, по которому попадает палец. -->
          <ToggleButton x:Name="GameModeButton" Content="Партия с ИИ" MinHeight="44" MinWidth="130" />
          <ToggleButton x:Name="NetworkModeButton"
                        Content="Партия с другом"
                        MinHeight="44"
                        MinWidth="170"
                        AutomationProperties.Name="Партия с другом" />
          <!-- «Задачи» больше не отдельный режим: это третий подраздел обучения
               (уточнение интерфейса 2026-11-09). В строке остаются три режима,
               освободившееся место занимает «Партия с другом». -->
          <ToggleButton x:Name="LessonModeButton" Content="Обучение" MinHeight="44" MinWidth="110" />
        </StackPanel>
        <TextBlock x:Name="ModeHintText"
                   Grid.Column="1"
                   Text="{Binding ModeHint}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="8,0,0,0"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBlock x:Name="NetworkModeHintText"
                   Grid.Column="1"
                   Text="Партия с другом: создайте комнату или присоединитесь."
                   IsVisible="False"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="8,0,0,0"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </Grid>
    </Border>

    <!-- Содержимое общее для обеих раскладок: виды разделов и общее меню живут здесь
         и не пересоздаются. В разделе «Обучение» сверху стоит переключатель трёх подразделов:
         уроки, разбор партий и задачи (задачи добавлены уточнением интерфейса 2026-11-09). -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <Border x:Name="StudySwitch"
              Grid.Row="0"
              IsVisible="False"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,6">
        <!-- Три подраздела обучения: уроки, разбор партий и задачи. Задачи переехали
             сюда из отдельного режима (уточнение интерфейса 2026-11-09). Столбцы делят
             ширину поровну: на телефоне 360 точек три подписи помещаются целиком. -->
        <Grid ColumnDefinitions="*,*,*">
          <ToggleButton x:Name="StudyLessonsButton"
                        Grid.Column="0"
                        Content="Уроки"
                        MinHeight="44"
                        MinWidth="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Stretch" />
          <ToggleButton x:Name="StudyReviewsButton"
                        Grid.Column="1"
                        Content="Партии"
                        MinHeight="44"
                        MinWidth="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Stretch" />
          <ToggleButton x:Name="StudyProblemsButton"
                        Grid.Column="2"
                        Content="Задачи"
                        MinHeight="44"
                        MinWidth="0"
                        HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Panel x:Name="ModeContent" Grid.Row="1">
        <!-- Главный экран — выбор режима: создаётся кодом вида, как и остальные разделы. -->
        <Panel x:Name="HomeHost" />
      </Panel>
    </Grid>

    <!-- «О программе»: вложенный экран раздела «Меню», а не отдельный раздел навигации.
         Закрывается кнопкой «Назад»; нижняя навигация остаётся видимой — так игрок понимает,
         что он внутри «Меню», и может уйти в другой раздел одним нажатием. -->
    <Border x:Name="AboutOverlay"
            Grid.Row="1"
            IsVisible="False"
            Background="{DynamicResource AppBackgroundBrush}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Стрелка нарисована вектором: значкового шрифта в проекте нет. -->
            <Button x:Name="AboutBackButton"
                    Classes="app-icon"
                    AutomationProperties.Name="Назад">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="M14.6,5.2 L7.8,12 L14.6,18.8 L16.7,16.7 L12,12 L16.7,7.3 Z" />
            </Button>
            <TextBlock Text="О программе"
                       Classes="app-subtitle"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <views:AboutView x:Name="AboutArea" Grid.Row="1" />
      </Grid>
    </Border>

    <!-- Словарь терминов: вложенный экран раздела «Обучение», как «О программе» у «Меню».
         Открывается кнопкой в панели урока; нижняя навигация остаётся видимой. -->
    <Border x:Name="GlossaryOverlay"
            Grid.Row="1"
            IsVisible="False"
            Background="{DynamicResource AppBackgroundBrush}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="GlossaryBackButton"
                    Classes="app-icon"
                    AutomationProperties.Name="Назад">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="M14.6,5.2 L7.8,12 L14.6,18.8 L16.7,16.7 L12,12 L16.7,7.3 Z" />
            </Button>
            <TextBlock Text="Словарь терминов"
                       Classes="app-subtitle"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <views:GlossaryView x:Name="GlossaryArea" Grid.Row="1" />
      </Grid>
    </Border>

    <!-- Сетевая игра: полноэкранный слой поверх содержимого, как «О программе». Открывается
         карточкой главного экрана, разделом «Меню» и строкой режимов, закрывается «Назад» или
         началом партии; нижняя навигация остаётся видимой, а вернувшись, игрок попадает туда,
         откуда пришёл. -->
    <Border x:Name="NetworkOverlay"
            Grid.Row="1"
            IsVisible="False"
            Background="{DynamicResource AppBackgroundBrush}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="NetworkBackButton"
                    Classes="app-icon"
                    AutomationProperties.Name="Назад">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Data="M14.6,5.2 L7.8,12 L14.6,18.8 L16.7,16.7 L12,12 L16.7,7.3 Z" />
            </Button>
            <TextBlock Text="Партия с другом"
                       Classes="app-subtitle"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Panel x:Name="NetworkHost" Grid.Row="1" />
      </Grid>
    </Border>

    <!-- Нижняя навигация телефона: значок и подпись, выбранный раздел выделен акцентом.
         Высота кнопки — 64 точки, цель нажатия заметно больше 48. -->
    <Border x:Name="MobileNav"
            Grid.Row="2"
            IsVisible="False"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
      <!-- Четыре раздела: «Партия с ИИ», «Партия с другом», «Обучение» и «Меню».
           «Задачи» — подраздел обучения, а не пятый раздел; главный экран в навигацию
           не входит: на него возвращает строка «Главная» общего меню. -->
      <Grid ColumnDefinitions="*,*,*,*" Height="{DynamicResource AppNavHeight}">

        <Button x:Name="NavGameButton"
                Grid.Column="0"
                Classes="app-nav"
                Classes.active="{Binding IsGameSection}"
                AutomationProperties.Name="Партия с ИИ">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <!-- Значок — вектор, а не шрифт: значкового шрифта в проекте нет. «Таблетка» вокруг
                 значка показывает выбранный раздел (Border.app-nav-icon). -->
            <Border Classes="app-nav-icon">
              <Path Width="22" Height="22" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M4,12 A8,8 0 1 1 20,12 A8,8 0 1 1 4,12 Z" />
            </Border>
            <TextBlock FontSize="10" Text="Партия с ИИ" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>

        <Button x:Name="NavNetworkButton"
                Grid.Column="1"
                Classes="app-nav"
                AutomationProperties.Name="Партия с другом"
                Click="OnNetworkModeClick">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <Border Classes="app-nav-icon">
              <Path Width="22" Height="22" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M3,4 h6 v8 h-6 z M4.5,6 h3 v1 h-3 z M4.5,8 h3 v1 h-3 z M15,12 h6 v8 h-6 z M16.5,14 h3 v1 h-3 z M16.5,16 h3 v1 h-3 z M9,7.5 h6 v2 h-6 z M12,9.5 h2 v2.5 h-2 z" />
            </Border>
            <TextBlock FontSize="10" Text="Партия с другом" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>

        <!-- «Обучение» — раздел практики: уроки, разбор партий и задачи. Стоит третьим,
             перед «Меню», которое разделом режима не является (замечание 2026-10-07). -->
        <Button x:Name="NavLessonButton"
                Grid.Column="2"
                Classes="app-nav"
                Classes.active="{Binding IsLessonSection}"
                AutomationProperties.Name="Обучение">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <!-- Раскрытая книга: значок обучения без значкового шрифта. -->
            <Border Classes="app-nav-icon">
              <Path Width="22" Height="22" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M4,4 h6.6 v15 h-6.6 z M13.4,4 h6.6 v15 h-6.6 z" />
            </Border>
            <TextBlock Text="Обучение" />
          </StackPanel>
        </Button>

        <!-- «Меню» — полноценный раздел: выбор режима, «О программе» и выход из игры.
             Раньше это была кнопка, открывавшая карточку меню партии; теперь меню партии
             открывается из шапки партии, а раздел занят общим меню приложения
             (замечание пользователя 2026-10-06). -->
        <Button x:Name="NavMenuButton"
                Grid.Column="3"
                Classes="app-nav"
                Classes.active="{Binding IsMenuSection}"
                AutomationProperties.Name="Меню">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <!-- Три полосы: значок меню без значкового шрифта. -->
            <Border Classes="app-nav-icon">
              <Path Width="22" Height="22" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M4,6.5 h16 v2 h-16 z M4,11 h16 v2 h-16 z M4,15.5 h16 v2 h-16 z" />
            </Border>
            <TextBlock Text="Меню" />
          </StackPanel>
        </Button>

      </Grid>
    </Border>

    <!-- Место приглашения обновления: слой поверх содержимого оболочки во всю её высоту.
         Карточку строит код вида (ShellView.axaml.cs) и получает общую модель обновления — ту же,
         что и экран «О программе». Слой растянут на все строки сетки, а сам он нажатия не ловит:
         пустая панель без фона прозрачна для указателя, поэтому спрятанное приглашение
         не мешает играть. -->
    <Panel x:Name="UpdateHost"
           Grid.Row="0"
           Grid.RowSpan="3"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch" />

    <!-- Подтверждение выхода: выход закрывает программу, поэтому спрашиваем — случайное нажатие
         не должно уносить несохранённую партию (замечание пользователя 2026-10-06). Затемнение
         берётся из темы, карточка стоит по центру. -->
    <Border x:Name="ExitOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="False"
            Classes="app-overlay">
      <Border Classes="app-banner app-overlay-card"
              MaxWidth="420"
              Padding="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Classes="app-subtitle"
                     Text="Выйти из игры?"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="app-label"
                     Text="Несохранённая партия будет потеряна."
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <Button x:Name="ExitCancelButton"
                    Grid.Column="0"
                    Content="Отмена"
                    Classes="app-action"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch" />
            <Button x:Name="ExitConfirmButton"
                    Grid.Column="1"
                    Content="Выйти"
                    Classes="app-action danger"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Stretch" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
