<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoEngine.App.Views"
        x:Class="GoEngine.App.Views.AboutWindow"
        Title="О программе"
        Width="440"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!-- Окно — тонкая обёртка вокруг общего вида «О программе»: тот же AboutView показывает телефон
       вложенным экраном раздела «Меню», потому что окон на телефоне нет. Высота задана, а не
       подбирается по содержимому: строки состояния разной длины, и окно дёргалось бы при
       обновлении хода загрузки. -->
  <Grid RowDefinitions="*,Auto">

    <views:AboutView x:Name="AboutArea" Grid.Row="0" />

    <Border Grid.Row="1"
            Padding="12,8"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource AppSurfaceBrush}">
      <Button x:Name="CloseButton"
              Content="Закрыть"
              Classes="app-action"
              HorizontalAlignment="Right"
              IsDefault="True"
              IsCancel="True" />
    </Border>

  </Grid>
</Window>
