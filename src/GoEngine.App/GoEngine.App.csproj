<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Библиотека интерфейса: виды, модель представления, настройки, SGF, рисование.
    Головы (GoEngine.App.Desktop, GoEngine.App.Android) добавляют точку входа и платформу;
    так один и тот же BoardView работает и на настольных системах, и на телефоне.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
      <!-- XML-документация обязательна: публичный член без <summary> ломает сборку. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <!-- Файловый лог: свой провайдер поверх Microsoft.Extensions.Logging (внешние провайдеры
         в проект не добавляются). Пишет его только слой App — в Core и AI логов нет. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка одна на все платформы: окно берёт её отсюда, настольная голова — для exe,
         Android — свои плотности из Resources (см. tools/make-icon в отчёте задачи). -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- Списки свойств, по которым вид пересобирает панель, — внутренние детали вида (срез
       рефакторинга 2026-10-02). Тестам нужен к ним доступ, чтобы сверять их с моделью
       представления, а публичный API библиотеки при этом не расширяется. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GoEngine.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GoEngine.Core/GoEngine.Core.csproj" />
    <ProjectReference Include="../GoEngine.AI/GoEngine.AI.csproj" />
    <!-- Режим задач: библиотека задач и сессия решения живут отдельным проектом, чтобы логика
         задач не смешивалась с логикой партии (D-061). -->
    <ProjectReference Include="../GoEngine.Problems/GoEngine.Problems.csproj" />
  </ItemGroup>

</Project>