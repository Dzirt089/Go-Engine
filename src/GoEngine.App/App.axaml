<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Единый визуальный язык: палитра, типографика, радиусы, отступы. -->
        <ResourceInclude Source="avares://GoEngine.App/Views/UiTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Порядок включения стилей важен: при равной специфичности в Avalonia побеждает правило,
       объявленное позже. Поэтому сначала идёт общий мобильный файл, затем мобильные уточнения
       и только потом общие стили органов управления с настольными размерами. Перестановка
       превратит настольные кнопки в мобильные — проверяйте этот порядок перед правками. -->
  <Application.Styles>
    <FluentTheme />
    <!-- Стили мобильного вида: все селекторы привязаны к классам .app-*, поэтому настольный
         вид получает только общие цвета, но не новые правила оформления. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.axaml" />
    <!-- Мобильные размеры для уже объявленных классов: цель нажатия 48 точек. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.Mobile.axaml" />
    <!-- Общие стили органов управления: ряд кнопок, переключатель территории, баннер итога. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.Controls.axaml" />
  </Application.Styles>

</Application>
