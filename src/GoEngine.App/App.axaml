<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GoEngine.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Единый визуальный язык: палитра, типографика, радиусы, отступы. -->
        <ResourceInclude Source="avares://GoEngine.App/Views/UiTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Порядок включения стилей важен: при равной специфичности в Avalonia побеждает правило,
       объявленное позже. Поэтому сначала идёт общий файл (база и классы .app-*), затем мобильные
       уточнения размеров и только потом общие стили органов управления с настольными размерами.
       Перестановка превратит настольные кнопки в мобильные — проверяйте этот порядок перед
       правками. -->
  <Application.Styles>
    <!-- Тема Fluent: её палитра акцента берётся из нашего токена, чтобы фокус, выделение,
         флажки и полосы прогресса жили в одном цвете с кнопками. Значения дублируют
         AppAccentColor из UiTheme.axaml: Fluent не умеет читать наш ресурс в момент создания
         палитры, а расхождение — ошибка, а не настройка. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Светлая тема: на светлой подложке нужен глубокий синий (WCAG AA). -->
        <ColorPaletteResources x:Key="Light" Accent="#1F62C4" />
        <!-- Тёмная тема: тот же акцент, что на главном экране. -->
        <ColorPaletteResources x:Key="Dark" Accent="#6CB6FF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Базовые правила и классы оформления: все селекторы — классы .app-* и стандартные
         элементы управления, поэтому один файл задаёт язык всем экранам сразу. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.axaml" />
    <!-- Мобильные размеры для уже объявленных классов: цель нажатия 48 точек. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.Mobile.axaml" />
    <!-- Общие стили органов управления: ряд кнопок, переключатель территории, баннер итога. -->
    <StyleInclude Source="avares://GoEngine.App/Views/UiStyles.Controls.axaml" />
  </Application.Styles>

</Application>
