<Project Sdk="Microsoft.NET.Sdk">

  <!-- Общие свойства — в Directory.Build.props. Слой задач ссылается на Core и AI (проверка глаз). -->
  <PropertyGroup>
    <!-- XML-документация обязательна: публичный член без <summary> ломает сборку. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Задачи лежат встроенными ресурсами: набор доступен на всех платформах, включая Android,
       без правок упаковки. Формат — SGF с вариантами (см. ProblemSgf). Уроки устроены так же,
       только формат у них JSON: тексты, позиции и принимаемые ходы (см. LessonJson).
       Обучающие партии — тоже JSON: полная запись игры и разбор по ходам (см. ReviewJson). -->
  <ItemGroup>
    <EmbeddedResource Include="Problems/*.sgf" />
    <EmbeddedResource Include="Lessons/*.json" />
    <EmbeddedResource Include="Glossary/*.json" />
    <EmbeddedResource Include="Games/*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoEngine.Core\GoEngine.Core.csproj" />
    <ProjectReference Include="..\GoEngine.AI\GoEngine.AI.csproj" />
  </ItemGroup>

</Project>
