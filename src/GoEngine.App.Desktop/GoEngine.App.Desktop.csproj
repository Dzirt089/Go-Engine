<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Голова настольной версии: точка входа и проверочные режимы. Интерфейс живёт в библиотеке
    GoEngine.App — её же использует голова Android, поэтому логика и виды не дублируются.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GoEngine.App.Desktop</AssemblyName>
    <RootNamespace>GoEngine.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Иконка exe и установщика: один файл с семью размерами, нарисован тем же кодом,
         что и иконка окна (см. src/GoEngine.App/Assets). -->
    <ApplicationIcon>../GoEngine.App/Assets/goengine.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- PNG-иконки кладём рядом с приложением: их берут ярлыки Linux и поставка macOS. -->
    <None Include="../GoEngine.App/Assets/goengine-256.png" Link="goengine-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../GoEngine.App/Assets/goengine-512.png" Link="goengine-512.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="SkiaSharp" />
    <!-- Нативная Skia для Linux обязана совпадать по версии с управляемой SkiaSharp: иначе в сборку
         для Linux попадает библиотека 2.88 и приложение падает на старте (проверено на релизном
         архиве: libSkiaSharp.so сообщал 88.1 при управляемой 3.116). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GoEngine.App/GoEngine.App.csproj" />
    <ProjectReference Include="../GoEngine.AI.Onnx/GoEngine.AI.Onnx.csproj" />
  </ItemGroup>

</Project>