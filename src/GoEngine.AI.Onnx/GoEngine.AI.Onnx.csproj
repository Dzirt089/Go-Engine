<Project Sdk="Microsoft.NET.Sdk">

  <!-- Общие свойства — в Directory.Build.props. Слой ONNX ссылается на Core и AI -->

  <PropertyGroup>
    <!-- XML-документация обязательна: публичный член без <summary> ломает сборку. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoEngine.Core\GoEngine.Core.csproj" />
    <ProjectReference Include="..\GoEngine.AI\GoEngine.AI.csproj" />
  </ItemGroup>

  <!-- Сессия модели и разбор выходов — внутренние типы слоя (срез 3 фазы 11). Тестам нужен
       доступ к ним, чтобы проверять математику и жизненный цикл по отдельности, а публичный
       API слоя при этом не расширяется. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GoEngine.Tests" />
  </ItemGroup>

</Project>
