# Правила стиля Go Engine.
# Дополняют AGENTS.md и AGENTS_GO.md: там смысл, здесь — то, что проверяет редактор и сборка.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,axaml,xaml,json,md,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Файлы — с file-scoped namespace, using внутри namespace (AGENTS.md, п. 5).
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Стиль объявлений и модификаторов.
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_static_local_function = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning

# Современные возможности языка.
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Анализ кода: предупреждения, которые проект считает ошибками (TreatWarningsAsErrors).
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1303.severity = suggestion
dotnet_diagnostic.CA1707.severity = suggestion
dotnet_diagnostic.CA1812.severity = suggestion
dotnet_diagnostic.IDE0130.severity = none

# CA1000: «не объявлять статические члены в универсальных типах».
# Фабрики Result<T>.Ok и Result<T>.Fail — требование задачи T-009 и всего публичного API Core,
# поэтому правило отключено осознанно, а не из-за неудобства.
dotnet_diagnostic.CA1000.severity = none