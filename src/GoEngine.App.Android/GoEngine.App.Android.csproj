<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Голова Android: тот же интерфейс, что и на настольных системах (BoardView), но без меню —
    на Android жизненный цикл единственного вида. Проект не входит в GoEngine.sln: для его
    сборки нужна рабочая нагрузка android (dotnet workload install android), которой нет
    у того, кто собирает только настольную версию. Собирается в CI (.github/workflows/release.yml).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.goengine.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Сборка Android SDK предупреждает о подписи, ресурсах и линковке: это не наш код.
         Сборка релиза не должна из-за него падать; анализаторы остаются включёнными. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Проверку «срок поддержки цели» выключаем только здесь: на машине сборки может стоять
         SDK новее восьмого, и тогда net8.0-android объявляется вне поддержки. В CI стоит SDK 8. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GoEngine.App/GoEngine.App.csproj" />
    <ProjectReference Include="../GoEngine.AI.Onnx/GoEngine.AI.Onnx.csproj" />
  </ItemGroup>

  <!--
    Модели нейросети лежат внутри пакета как assets/models. На Android приложение не может
    читать файлы рядом с собой, поэтому при первом запуске они копируются в каталог приложения
    (см. AndroidModelStartup). В git модели не коммитятся: их кладёт в models/ сборка, CI
    скачивает их из релиза models-v1 с проверкой SHA-256.
  -->
  <ItemGroup>
    <ModelAssetFile Include="../../models/*.onnx" />
    <AndroidAsset Include="@(ModelAssetFile)" TargetPath="models/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- На сборочном агенте пустой каталог моделей — это ошибка: APK без моделей не даст
       уровней с нейросетью, а заметить это на телефоне можно только вручную. -->
  <Target Name="RequireModelAssets" BeforeTargets="Build" Condition="'$(CI)' == 'true'">
    <Error Condition="'@(ModelAssetFile)' == ''"
           Text="В APK не попадут модели: каталог models пуст. CI должен скачать их из релиза models-v1." />
  </Target>

</Project>