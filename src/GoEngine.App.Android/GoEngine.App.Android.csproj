<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Голова Android: тот же интерфейс, что и на настольных системах (BoardView), но без меню —
    на Android жизненный цикл единственного вида. Проект не входит в GoEngine.sln: для его
    сборки нужна рабочая нагрузка android (dotnet workload install android), которой нет
    у того, кто собирает только настольную версию. Собирается в CI (.github/workflows/release.yml).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.goengine.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Сборка Android SDK предупреждает о подписи, ресурсах и линковке: это не наш код.
         Сборка релиза не должна из-за него падать; анализаторы остаются включёнными. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Проверку «срок поддержки цели» выключаем только здесь: на машине сборки может стоять
         SDK новее восьмого, и тогда net8.0-android объявляется вне поддержки. В CI стоит SDK 8. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!--
    Нативная библиотека ONNX Runtime обязана быть android-сборкой из AAR. Пакет NuGet кладёт
    рядом и линуксовые копии (runtimes/linux-*/native/libonnxruntime.so), а граф идентификаторов
    .NET считает linux-arm64 совместимым с android-arm64:
    android-arm64 → linux-bionic-arm64 → linux-bionic → linux-arm64.
    Из-за этого в APK 0.2.33 для arm64 уехала ЛИНУКСОВАЯ библиотека (13 648 152 байта вместо
    17 584 840 из AAR), и на телефоне падала инициализация NativeMethods — модели не загружались,
    хотя сборка и все проверки были зелёными.
    ExcludeAssets="native" убирает все нативные копии пакета (проверено: в разрешении остаётся
    заглушка runtimes/<rid>/native/_._), а AAR подключается явно — из него Android SDK достаёт
    jni/<abi>/libonnxruntime.so. Проверка соответствия — в CI (сторож в build.yml).
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(PkgMicrosoft_ML_OnnxRuntime)/runtimes/android/native/onnxruntime.aar" />
  </ItemGroup>

  <!--
    Если пакет ONNX сменит раскладку, сборка обязана упасть здесь, а не выпустить APK без нативной
    библиотеки: такой пакет запускается, но уровни с сетью не работают, и заметить это можно только
    на телефоне.
  -->
  <Target Name="CheckOnnxAndroidLibrary" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PkgMicrosoft_ML_OnnxRuntime)/runtimes/android/native/onnxruntime.aar')"
           Text="Нет android-сборки ONNX Runtime: $(PkgMicrosoft_ML_OnnxRuntime)/runtimes/android/native/onnxruntime.aar. Без неё в APK не попадёт libonnxruntime.so, и модели не загрузятся." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../GoEngine.App/GoEngine.App.csproj" />
    <ProjectReference Include="../GoEngine.AI.Onnx/GoEngine.AI.Onnx.csproj" />
  </ItemGroup>

  <!--
    Модели нейросети лежат внутри пакета как assets/models. На Android приложение не может
    читать файлы рядом с собой, поэтому при первом запуске они копируются в каталог приложения
    (см. AndroidModelStartup). В git модели не коммитятся: их кладёт в models/ сборка, CI
    скачивает их из релиза models-v1 с проверкой SHA-256.
  -->
  <ItemGroup>
    <ModelAssetSource Include="../../models/*.onnx" />
  </ItemGroup>

  <!--
    Файлы из каталога вне проекта Android SDK в пакет не кладёт (проверено: сборка проходила,
    а внутри APK моделей не оказывалось). Поэтому перед сборкой модели копируются в каталог
    Assets/models внутри проекта и уже оттуда попадают в пакет как assets/models. В git они
    не коммитятся: файлы кладёт сборка, CI скачивает их из релиза models-v1 с проверкой SHA-256.
    На сборочном агенте пустой источник — ошибка: APK без моделей не даст уровней с нейросетью,
    а заметить это можно было бы только на телефоне.
  -->
  <Target Name="PrepareModelAssets" BeforeTargets="BeforeBuild">
    <Error Condition="'@(ModelAssetSource)' == '' and '$(CI)' == 'true'"
           Text="В APK не попадут модели: каталог models пуст. CI должен скачать их из релиза models-v1." />
    <Copy Condition="'@(ModelAssetSource)' != ''"
          SourceFiles="@(ModelAssetSource)"
          DestinationFolder="$(MSBuildProjectDirectory)/Assets/models"
          SkipUnchangedFiles="true" />
    <ItemGroup Condition="'@(ModelAssetSource)' != ''">
      <AndroidAsset Include="$(MSBuildProjectDirectory)/Assets/models/*.onnx" />
    </ItemGroup>
  </Target>

</Project>