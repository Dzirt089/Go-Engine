# Правила редактора для файлов вне src/: документы, скрипты, задачи.
# Исходники C# описаны отдельно — в src/.editorconfig (там свои правила и root = true).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml}]
indent_size = 2

# В markdown два пробела в конце строки — это перенос, их не срезаем.
[*.md]
trim_trailing_whitespace = false
